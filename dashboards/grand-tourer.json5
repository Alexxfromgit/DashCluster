// Grand Tourer — twin needle dials and a central instrument panel.
{
  name: "Grand Tourer",
  version: 1,
  description: "Twin midnight dials, centered gear, and a full-width engine telemetry strip.",
  canvas: { width: 1600, height: 900 },
  theme: {
    ink: "#f4f7ff", muted: "#a8bbd4", accent: "#50aaff", danger: "#ff4057",
    warn: "#ffcf38", ok: "#21f478", info: "#59baff", face: "#101924", edge: "#384c65",
  },
  background: { color: "#162332", gradient_to: "#070a10", gradient_angle: 155 },
  widgets: [
    { id: "telemetry_panel", type: "panel", x: 30, y: 704, w: 1540, h: 163, z: -1 },
    { id: "shift", type: "shift_lights", x: 480, y: 42, w: 640, h: 51, segments: 12,
      start: { signal: "rpm_max", scale: 0.70 }, limit: { signal: "rpm_max", scale: 0.96 },
      flash_color: "#ffffff" },
    { id: "center_panel", type: "panel", x: 584, y: 129, w: 432, h: 538, z: -1,
      style: { face: "#0d141e", edge: "#354965" } },
    { id: "tach", type: "analog_gauge", x: 30, y: 136, w: 528, h: 528,
      bind: { signal: "rpm", scale: 0.001, smoothing: 0.04 },
      max: { signal: "rpm_max", scale: 0.001, ceil_to: 1, fallback: 8 },
      zones: [ { from: { signal: "rpm_max", scale: 0.00092 }, color: "danger" } ],
      caption: "×1000 r/min", center: { bind: "rpm", format: { unit: "" } } },
    { id: "speedo", type: "analog_gauge", x: 1042, y: 136, w: 528, h: 528,
      bind: { signal: "speed", smoothing: 0.08 }, max: 280, major_ticks: 7, minor_ticks: 4 },

    { id: "blink_l", type: "lamp", x: 614, y: 158, w: 56, h: 42, bind: "blinker_left", icon: "◄", color: "ok" },
    { id: "blink_r", type: "lamp", x: 930, y: 158, w: 56, h: 42, bind: "blinker_right", icon: "►", color: "ok" },
    { id: "clock", type: "label", x: 690, y: 158, w: 220, h: 42, text: "{race_time}", color: "muted" },

    { id: "gear_title", type: "label", x: 720, y: 230, w: 160, h: 45, text: "GEAR", color: "muted" },
    { id: "gear", type: "gear", x: 676, y: 276, w: 248, h: 241,
      shift_at: { signal: "rpm_max", scale: 0.92 }, style: { accent: "danger" } },
    { id: "power", type: "readout", x: 75, y: 734, w: 264, h: 88, label: "POWER",
      bind: "power", zones: [ { to: 0, color: "info" } ] },
    { id: "boost", type: "readout", x: 399, y: 734, w: 258, h: 88, label: "BOOST",
      bind: "boost", format: { decimals: 2 } },

    { id: "torque", type: "bar_gauge", x: 724, y: 762, w: 415, h: 42, label: "TORQUE",
      bind: "torque", min: 0, max: 800, style: { accent: "#21568b" }, zones: [ { from: 650, color: "danger" } ] },
    { id: "fuel", type: "bar_gauge", x: 1171, y: 762, w: 348, h: 42, label: "FUEL",
      bind: "fuel", min: 0, max: 100, style: { accent: "#21568b" }, zones: [ { to: 12, color: "warn" } ] },

    { id: "hb", type: "lamp", x: 614, y: 571, w: 81, h: 43, bind: "handbrake", above: 10, icon: "HB", color: "danger" },
    { id: "slip", type: "lamp", x: 711, y: 571, w: 81, h: 43, bind: "slip_rl", above: 100, icon: "SLIP", blink: true },
    { id: "abs", type: "lamp", x: 808, y: 571, w: 81, h: 43, bind: "abs_active", icon: "ABS" },
    { id: "tc", type: "lamp", x: 905, y: 571, w: 81, h: 43, bind: "tc_active", icon: "TC" },
  ],
}
