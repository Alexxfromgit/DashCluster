// Grand Tourer — twin needle dials with dark hubs and a central instrument panel.
{
  name: "Grand Tourer",
  version: 1,
  description: "Twin midnight dials with hubs, centered gear and lamps, and a telemetry row.",
  canvas: { width: 1600, height: 900 },
  theme: {
    ink: "#f4f7ff", muted: "#8ea6c4", accent: "#4fa8ff", danger: "#ff3b55",
    warn: "#ffcf38", ok: "#2cf07c", info: "#5ab8ff", face: "#0a121d", edge: "#2d4260",
    unit: "#6f8fb6",
  },
  background: { color: "#04070c", gradient_to: "#0a1220", gradient_angle: 180 },
  widgets: [
    { id: "shift", type: "shift_lights", x: 500, y: 26, w: 600, h: 46, segments: 12,
      start: { signal: "rpm_max", scale: 0.70 }, limit: { signal: "rpm_max", scale: 0.96 },
      flash_color: "#ffffff" },
    { id: "tach", type: "analog_gauge", x: 30, y: 110, w: 540, h: 540, hub: true,
      bind: { signal: "rpm", scale: 0.001, smoothing: 0.04 },
      max: { signal: "rpm_max", scale: 0.001, ceil_to: 1, fallback: 8 },
      zones: [ { from: { signal: "rpm_max", scale: 0.00092 }, color: "danger" } ],
      caption: "×1000 r/min", center: { bind: "rpm", format: { unit: "" } } },
    { id: "speedo", type: "analog_gauge", x: 1030, y: 110, w: 540, h: 540, hub: true,
      bind: { signal: "speed", smoothing: 0.08 }, max: 280, major_ticks: 7, minor_ticks: 4 },

    { id: "center_panel", type: "panel", x: 600, y: 120, w: 400, h: 520, z: -1, variant: "chamfer",
      style: { face: "#070d16", edge: "#2d4260" } },
    { id: "blink_l", type: "lamp", x: 626, y: 146, w: 60, h: 44, bind: "blinker_left", icon: "◄", color: "ok" },
    { id: "blink_r", type: "lamp", x: 914, y: 146, w: 60, h: 44, bind: "blinker_right", icon: "►", color: "ok" },
    { id: "clock", type: "label", x: 696, y: 148, w: 208, h: 40, text: "{race_time:time}", color: "muted" },
    { id: "gear", type: "gear", x: 680, y: 214, w: 240, h: 270, shift_at: { signal: "rpm_max", scale: 0.92 },
      style: { accent: "danger" } },
    { id: "hb", type: "lamp", x: 626, y: 560, w: 80, h: 44, bind: "handbrake", above: 10, icon: "HB", color: "danger" },
    { id: "slip", type: "lamp", x: 716, y: 560, w: 80, h: 44, bind: "slip_rl", above: 100, icon: "SLIP", blink: true },
    { id: "abs", type: "lamp", x: 806, y: 560, w: 80, h: 44, bind: "abs_active", icon: "ABS" },
    { id: "tc", type: "lamp", x: 896, y: 560, w: 78, h: 44, bind: "tc_active", icon: "TC" },

    { id: "row", type: "panel", x: 30, y: 690, w: 1540, h: 150, z: -1, variant: "divider", edges: ["top", "bottom"],
      style: { face: "transparent" } },
    { id: "power", type: "readout", x: 60, y: 708, w: 260, h: 110, label: "POWER", align: "left",
      bind: "power", zones: [ { to: 0, color: "info" } ] },
    { id: "boost", type: "readout", x: 350, y: 708, w: 260, h: 110, label: "BOOST", align: "left",
      bind: "boost", format: { decimals: 2 } },
    { id: "torque", type: "bar_gauge", x: 660, y: 736, w: 420, h: 50, label: "TORQUE",
      bind: "torque", min: 0, max: 800, style: { accent: "#2a6fc0", face: "#070d16" }, zones: [ { from: 650, color: "danger" } ] },
    { id: "fuel", type: "bar_gauge", x: 1110, y: 736, w: 430, h: 50, label: "FUEL",
      bind: "fuel", min: 0, max: 100, style: { accent: "#2a6fc0", face: "#070d16" }, zones: [ { to: 12, color: "warn" } ] },
    { id: "lap_no", type: "label", x: 40, y: 852, w: 500, h: 36, text: "LAP {lap_number}   ·   P{race_position}",
      align: "left", color: "muted" },
    { id: "best", type: "label", x: 1060, y: 852, w: 500, h: 36, text: "BEST {best_lap:time}", align: "right", color: "muted" },
  ],
}
