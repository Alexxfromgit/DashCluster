// Rally — a sweeping tach with inset speed, staged timing and driver inputs.
{
  name: "Rally",
  version: 1,
  description: "Big wrap-around tach, boost and g-forces.",
  canvas: { width: 1600, height: 900 },
  theme: {
    ink: "#f3f8ff", muted: "#a3b8d9", accent: "#43d3ff", danger: "#ff405c",
    warn: "#ffcb36", ok: "#27ef8e", info: "#43d3ff", face: "#101a2b", edge: "#365275",
  },
  background: { color: "#162638", gradient_to: "#050812", gradient_angle: 145 },
  widgets: [
    { id: "shift", type: "shift_lights", x: 500, y: 39, w: 600, h: 54, segments: 12,
      start: { signal: "rpm_max", scale: 0.70 }, limit: { signal: "rpm_max", scale: 0.95 },
      flash_color: "#ffffff" },
    { id: "vehicle_panel", type: "panel", x: 28, y: 152, w: 400, h: 704, z: -1 },
    { id: "timing_panel", type: "panel", x: 1172, y: 152, w: 400, h: 704, z: -1 },
    { id: "tach", type: "analog_gauge", x: 467, y: 116, w: 666, h: 666, indicator: "arc",
      bind: { signal: "rpm", scale: 0.001, smoothing: 0.03 },
      max: { signal: "rpm_max", scale: 0.001, ceil_to: 1, fallback: 8 },
      start_angle: -126, sweep: 252, minor_ticks: 4, caption: "×1000 r/min",
      zones: [ { from: { signal: "rpm_max", scale: 0.0009 }, color: "danger" } ],
      center: { bind: "speed", show_unit: true }, style: { face: "#0a1222" } },
    { id: "gear_title", type: "label", x: 728, y: 594, w: 144, h: 32, text: "GEAR", color: "muted" },
    { id: "gear", type: "gear", x: 704, y: 631, w: 192, h: 110,
      shift_at: { signal: "rpm_max", scale: 0.93 }, style: { accent: "danger", font_scale: 0.86 } },

    { id: "title", type: "label", x: 52, y: 47, w: 370, h: 57, text: "STAGE {lap_number}",
      align: "left", color: "accent" },
    { id: "g", type: "g_meter", x: 86, y: 207, w: 284, h: 284, max_g: 1.5, style: { face: "#0a1222" } },
    { id: "boost", type: "bar_gauge", x: 55, y: 545, w: 346, h: 51, label: "BOOST",
      bind: "boost", min: 0, max: 1.5, format: { decimals: 1 }, style: { face: "#0a1222", accent: "#185986" } },
    { id: "torque", type: "readout", x: 55, y: 656, w: 346, h: 109, label: "TORQUE", bind: "torque" },

    { id: "lap", type: "lap_timer", x: 1197, y: 207, w: 350, h: 301, show_best: false },
    { id: "pedals", type: "pedals", x: 1197, y: 557, w: 350, h: 237,
      signals: ["throttle", "brake", "handbrake"], colors: ["ok", "danger", "warn"],
      style: { face: "#0a1222", font_scale: 1.45 } },
  ],
}
