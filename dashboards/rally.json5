// Rally — a rising rainbow RPM ramp over a hex gear box, with stage time, g-forces and inputs below.
{
  name: "Rally",
  version: 1,
  description: "Rising RPM ramp, hex gear, speed box, stage timing, g-meter and inputs.",
  canvas: { width: 1600, height: 900 },
  theme: {
    ink: "#f3f6fb", muted: "#8ea2bd", accent: "#37d3ff", danger: "#ff2f55",
    warn: "#ffd02e", ok: "#36ef7a", info: "#37d3ff", face: "#0a0d14", edge: "#2b3546",
    unit: "#37d3ff",
  },
  background: { color: "#04050a", gradient_to: "#0b0f1a", gradient_angle: 180 },
  widgets: [
    { id: "stage", type: "label", x: 40, y: 20, w: 400, h: 50, text: "STAGE {lap_number}", align: "left", color: "accent" },
    { id: "hb", type: "lamp", x: 1440, y: 22, w: 120, h: 46, bind: "handbrake", above: 10, icon: "HB", color: "danger" },
    { id: "tach", type: "bar_gauge", x: 60, y: 84, w: 1480, h: 140, bind: { signal: "rpm", smoothing: 0.03 },
      max: { signal: "rpm_max", fallback: 8000 }, show_value: false, ramp_segments: 44,
      zones: [ { to: { signal: "rpm_max", scale: 0.55, fallback: 4400 }, color: "ok" },
        { from: { signal: "rpm_max", scale: 0.55, fallback: 4400 }, to: { signal: "rpm_max", scale: 0.8, fallback: 6400 }, color: "warn" },
        { from: { signal: "rpm_max", scale: 0.8, fallback: 6400 }, color: "danger" } ] },
    { id: "rpm", type: "readout", x: 60, y: 232, w: 300, h: 92, bind: "rpm", label: "RPM", align: "left",
      label_position: "below", format: { unit: "" } },

    // Middle row
    { id: "boost_g", type: "analog_gauge", x: 110, y: 300, w: 270, h: 270, indicator: "arc",
      bind: { signal: "boost", smoothing: 0.06 }, min: 0, max: 1.5, major_ticks: 3, minor_ticks: 5,
      start_angle: -110, sweep: 220, caption: "BOOST", center: { bind: "boost", format: { decimals: 2 } },
      zones: [ { from: 1.2, color: "danger" } ] },
    { id: "gear", type: "gear", x: 590, y: 270, w: 420, h: 300, frame: "hex",
      shift_at: { signal: "rpm_max", scale: 0.93 }, style: { accent: "danger", face: "#0d111b", edge: "#56657c" } },
    { id: "speed_box", type: "panel", x: 1110, y: 300, w: 420, h: 250, z: -1, variant: "chamfer",
      style: { face: "#0d111b", edge: "#56657c" } },
    { id: "speed", type: "readout", x: 1140, y: 320, w: 360, h: 210, bind: "speed", label: "KM/H",
      label_position: "below", format: { unit: "" }, style: { font_scale: 1.1 } },

    // Bottom row
    { id: "row", type: "panel", x: 30, y: 600, w: 1540, h: 2, z: -1, variant: "strip", style: { face: "#2b3546" } },
    { id: "time_box", type: "panel", x: 30, y: 630, w: 470, h: 250, z: -1, variant: "chamfer", title: "STAGE TIME" },
    { id: "lap", type: "readout", x: 60, y: 676, w: 410, h: 110, bind: "lap_time", align: "left",
      format: { style: "time" } },
    { id: "last", type: "readout", x: 60, y: 790, w: 410, h: 70, bind: "last_lap", label: "LAST", align: "left",
      label_position: "below", format: { style: "time" }, style: { ink: "#c5cfdd" } },
    { id: "g_box", type: "panel", x: 520, y: 630, w: 300, h: 250, z: -1, variant: "chamfer" },
    { id: "g", type: "g_meter", x: 545, y: 640, w: 250, h: 230, max_g: 1.5, style: { face: "#0d111b" } },
    { id: "in_box", type: "panel", x: 840, y: 630, w: 300, h: 250, z: -1, variant: "chamfer" },
    { id: "pedals", type: "pedals", x: 860, y: 646, w: 260, h: 220, show_values: true,
      signals: ["throttle", "brake", "handbrake"], colors: ["ok", "danger", "warn"],
      style: { face: "#06080d", font_scale: 1.4 } },
    { id: "eng_box", type: "panel", x: 1160, y: 630, w: 410, h: 250, z: -1, variant: "chamfer" },
    { id: "torque", type: "readout", x: 1190, y: 650, w: 350, h: 96, bind: "torque", label: "TORQUE", align: "right" },
    { id: "torque_bar", type: "bar_gauge", x: 1190, y: 752, w: 350, h: 14, bind: "torque", min: 0, max: 800, show_value: false,
      style: { face: "#05070c", accent: "accent" } },
    { id: "fuel", type: "bar_gauge", x: 1190, y: 800, w: 350, h: 50, label: "FUEL", bind: "fuel", max: 100,
      style: { face: "#05070c", accent: "#1d6f8a" }, zones: [ { to: 12, color: "danger" } ] },
  ],
}
