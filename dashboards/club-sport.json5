// A single yellow dial with a gear center and a compact set of engine readouts.
{
  name: "Club Sport",
  description: "Yellow tachometer, centered gear, and live engine and lap readouts.",
  canvas: { width: 1280, height: 720 },
  theme: {
    ink: "#f6f8fc", muted: "#acb5c4", accent: "#ffd528", danger: "#ff4055",
    warn: "#ffee50", ok: "#30f877", info: "#63bdff", face: "#161b23", edge: "#3d4653",
  },
  background: { color: "#20242e", gradient_to: "#080a0f", gradient_angle: 145 },
  widgets: [
    { id: "left_panel", type: "panel", x: 30, y: 126, w: 268, h: 393, z: -1 },
    { id: "right_panel", type: "panel", x: 982, y: 126, w: 268, h: 393, z: -1 },
    { id: "footer", type: "panel", x: 32, y: 606, w: 1216, h: 82, z: -1,
      style: { face: "#171d28", edge: "#4b5566" } },
    { id: "shift", type: "shift_lights", x: 428, y: 26, w: 424, h: 43, segments: 10,
      start: { signal: "rpm_max", scale: 0.66 }, limit: { signal: "rpm_max", scale: 0.96 },
      flash_color: "#ffffff" },
    { id: "tach", type: "analog_gauge", x: 382, y: 76, w: 516, h: 516, indicator: "arc",
      bind: { signal: "rpm", scale: 0.001, smoothing: 0.045 },
      max: { signal: "rpm_max", scale: 0.001, ceil_to: 1, fallback: 8 },
      zones: [ { from: { signal: "rpm_max", scale: 0.0009, fallback: 7.2 }, color: "danger" } ],
      start_angle: -128, sweep: 256, minor_ticks: 3, caption: "GEAR",
      center: { bind: "gear", format: { style: "gear", unit: "" } }, style: { face: "#0a0f16" } },
    { id: "rpm", type: "readout", x: 558, y: 473, w: 164, h: 58, bind: "rpm", label: "RPM", format: { unit: "" },
      style: { ink: "accent" } },
    { id: "boost", type: "readout", x: 49, y: 157, w: 230, h: 86, bind: "boost", label: "BOOST", format: { decimals: 2 } },
    { id: "power", type: "readout", x: 49, y: 277, w: 230, h: 86, bind: "power", label: "POWER" },
    { id: "torque", type: "readout", x: 49, y: 397, w: 230, h: 86, bind: "torque", label: "TORQUE" },
    { id: "speed", type: "readout", x: 1001, y: 157, w: 230, h: 86, bind: "speed", label: "SPEED" },
    { id: "fuel", type: "readout", x: 1001, y: 277, w: 230, h: 86, bind: "fuel", label: "FUEL",
      zones: [ { to: 12, color: "warn" } ] },
    { id: "position", type: "readout", x: 1001, y: 397, w: 230, h: 86, bind: "race_position", label: "POSITION" },
    { id: "lap_number", type: "readout", x: 54, y: 620, w: 240, h: 56, bind: "lap_number", label: "LAP" },
    { id: "lap", type: "readout", x: 330, y: 620, w: 276, h: 56, bind: "lap_time", label: "CURRENT LAP",
      format: { style: "time" } },
    { id: "last", type: "readout", x: 650, y: 620, w: 276, h: 56, bind: "last_lap", label: "LAST LAP",
      format: { style: "time" } },
    { id: "best", type: "readout", x: 966, y: 620, w: 248, h: 56, bind: "best_lap", label: "BEST LAP",
      format: { style: "time" }, style: { ink: "accent" } },
  ],
}
