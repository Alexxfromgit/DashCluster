// Club Sport — a grey tachometer with the gear in a black hub, amber-labelled readouts either side.
{
  name: "Club Sport",
  description: "Needle tachometer with the gear in its hub, engine readouts at the sides and lap times below.",
  canvas: { width: 1280, height: 720 },
  theme: {
    ink: "#ffffff", muted: "#ffb21f", accent: "#ff3b1f", danger: "#ff2b2b",
    warn: "#ffd21f", ok: "#3df07a", info: "#4fb0ff", face: "#24272c", edge: "#4b5058",
  },
  background: { color: "#0d0f12", gradient_to: "#030405", gradient_angle: 180 },
  widgets: [
    { id: "shift", type: "shift_lights", x: 440, y: 12, w: 400, h: 42, segments: 9,
      start: { signal: "rpm_max", scale: 0.66 }, limit: { signal: "rpm_max", scale: 0.96 },
      colors: ["ok", "ok", "ok", "ok", "warn", "warn", "warn", "danger", "danger"], flash_color: "#ffffff" },

    { id: "tach", type: "analog_gauge", x: 400, y: 62, w: 480, h: 480, hub: true,
      bind: { signal: "rpm", scale: 0.001, smoothing: 0.045 },
      max: { signal: "rpm_max", scale: 0.001, ceil_to: 1, fallback: 8 },
      zones: [ { from: { signal: "rpm_max", scale: 0.0009, fallback: 7.2 }, color: "danger" } ],
      start_angle: -135, sweep: 225, minor_ticks: 5, caption: "RPM",
      center: { bind: "gear", format: { style: "gear", unit: "" } },
      style: { face: "#1c1f24", edge: "#e8e8e8", muted: "#ffb21f" } },

    { id: "boost", type: "readout", x: 40, y: 90, w: 300, h: 130, bind: "boost", label: "BOOST",
      label_position: "below", align: "left", format: { decimals: 2, unit: "" } },
    { id: "power", type: "readout", x: 40, y: 250, w: 300, h: 130, bind: "power", label: "POWER kW",
      label_position: "below", align: "left", format: { unit: "" } },
    { id: "tc", type: "lamp", x: 40, y: 430, w: 110, h: 54, bind: "tc_active", icon: "TC" },
    { id: "abs", type: "lamp", x: 164, y: 430, w: 110, h: 54, bind: "abs_active", icon: "ABS" },

    { id: "speed", type: "readout", x: 940, y: 90, w: 300, h: 130, bind: "speed", label: "SPEED",
      label_position: "below", align: "right", format: { unit: "" } },
    { id: "torque", type: "readout", x: 940, y: 250, w: 300, h: 130, bind: "torque", label: "TORQUE N·m",
      label_position: "below", align: "right", format: { unit: "" } },
    { id: "pit", type: "lamp", x: 1006, y: 430, w: 110, h: 54, bind: "pit_limiter", icon: "PIT", color: "info" },
    { id: "hb", type: "lamp", x: 1130, y: 430, w: 110, h: 54, bind: "handbrake", above: 10, icon: "HB", color: "danger" },

    { id: "bottom", type: "panel", x: 0, y: 560, w: 1280, h: 160, z: -1, variant: "divider", edges: ["top"],
      style: { face: "#050607", edge: "#3a3f46" } },
    { id: "lap", type: "readout", x: 60, y: 578, w: 360, h: 120, bind: "lap_time", label: "LAP TIME",
      label_position: "below", format: { style: "time" } },
    { id: "last", type: "readout", x: 460, y: 578, w: 360, h: 120, bind: "last_lap", label: "LAST LAP",
      label_position: "below", format: { style: "time" } },
    { id: "best", type: "readout", x: 860, y: 578, w: 360, h: 120, bind: "best_lap", label: "BEST LAP",
      label_position: "below", format: { style: "time" } },
  ],
}
