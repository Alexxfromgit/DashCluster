// Twin yellow arcs and a narrow timing column, inspired by modern race displays.
{
  name: "Apex",
  description: "Twin illuminated arcs for speed and RPM, with gear, lap timing and a lower telemetry strip.",
  canvas: { width: 1600, height: 900 },
  theme: {
    ink: "#f5f7fc", muted: "#a9b5c3", accent: "#dfff23", danger: "#ff3e55",
    warn: "#ffd33d", ok: "#46f779", info: "#54c8ed", face: "#131820", edge: "#3d4654",
  },
  background: { color: "#1a1e27", gradient_to: "#090b10", gradient_angle: 150 },
  widgets: [
    { id: "timing_panel", type: "panel", x: 620, y: 152, w: 360, h: 510, z: -1,
      style: { face: "#0f131a", edge: "#4b5360" } },
    { id: "footer", type: "panel", x: 36, y: 708, w: 1528, h: 155, z: -1 },
    { id: "shift", type: "shift_lights", x: 490, y: 42, w: 620, h: 55, segments: 12,
      start: { signal: "rpm_max", scale: 0.65 }, limit: { signal: "rpm_max", scale: 0.96 }, flash_color: "#ffffff" },
    { id: "speedo", type: "analog_gauge", x: 60, y: 151, w: 515, h: 515, indicator: "arc",
      bind: { signal: "speed", smoothing: 0.08 }, max: 320, major_ticks: 8, minor_ticks: 2,
      start_angle: -135, sweep: 270, style: { face: "#0a0e15", edge: "#3b4452" } },
    { id: "tach", type: "analog_gauge", x: 1025, y: 151, w: 515, h: 515, indicator: "arc",
      bind: { signal: "rpm", scale: 0.001, smoothing: 0.045 },
      max: { signal: "rpm_max", scale: 0.001, ceil_to: 1, fallback: 8 },
      zones: [ { from: { signal: "rpm_max", scale: 0.00092, fallback: 7.36 }, color: "danger" } ],
      minor_ticks: 2, caption: "GEAR", center: { bind: "gear", format: { style: "gear", unit: "" } },
      style: { face: "#0a0e15", edge: "#3b4452" } },
    { id: "rpm", type: "readout", x: 1184, y: 550, w: 198, h: 66, bind: "rpm", label: "RPM",
      format: { unit: "" }, style: { ink: "accent" } },
    { id: "position", type: "label", x: 640, y: 188, w: 320, h: 65,
      text: "P{race_position}  /  LAP {lap_number}", color: "accent" },
    { id: "lap", type: "readout", x: 647, y: 287, w: 306, h: 116, bind: "lap_time", label: "CURRENT LAP",
      format: { style: "time" } },
    { id: "best", type: "readout", x: 647, y: 459, w: 306, h: 122, bind: "best_lap", label: "BEST LAP",
      format: { style: "time" }, style: { ink: "accent" } },
    { id: "boost", type: "readout", x: 62, y: 740, w: 300, h: 88, bind: "boost", label: "BOOST", format: { decimals: 2 } },
    { id: "power", type: "readout", x: 438, y: 740, w: 300, h: 88, bind: "power", label: "POWER" },
    { id: "torque", type: "readout", x: 832, y: 740, w: 300, h: 88, bind: "torque", label: "TORQUE" },
    { id: "fuel", type: "bar_gauge", x: 1202, y: 760, w: 329, h: 47, bind: "fuel", label: "FUEL", max: 100,
      style: { face: "#0a0e15", accent: "#347486" }, zones: [ { to: 12, color: "danger" } ] },
  ],
}
