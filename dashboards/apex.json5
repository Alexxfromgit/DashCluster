// Apex — a big yellow tach with the gear in its hub, engine bars at the sides and a yellow timing strip.
{
  name: "Apex",
  description: "Yellow arc tachometer with the gear in the hub, engine bars, speed and a timing strip.",
  canvas: { width: 1600, height: 900 },
  theme: {
    ink: "#f7f8fa", muted: "#a3acb8", accent: "#ffc414", danger: "#ff2e40",
    warn: "#ffc414", ok: "#44ef7a", info: "#45c6ff", face: "#08090b", edge: "#2b3038",
    unit: "#ffc414",
  },
  background: { color: "#020203" },
  widgets: [
    { id: "shift", type: "shift_lights", x: 500, y: 16, w: 600, h: 44, segments: 12,
      start: { signal: "rpm_max", scale: 0.65 }, limit: { signal: "rpm_max", scale: 0.96 }, flash_color: "#ffffff" },

    // Left: engine bars
    { id: "boost_lbl", type: "label", x: 40, y: 120, w: 300, h: 36, text: "BOOST", align: "left", color: "muted" },
    { id: "boost", type: "bar_gauge", x: 40, y: 162, w: 420, h: 62, bind: "boost", min: 0, max: 1.5,
      format: { decimals: 2 }, style: { face: "#121418" } },
    { id: "power_lbl", type: "label", x: 40, y: 270, w: 300, h: 36, text: "POWER", align: "left", color: "muted" },
    { id: "power", type: "bar_gauge", x: 40, y: 312, w: 420, h: 62, bind: "power", min: 0, max: 600,
      style: { face: "#121418" } },
    { id: "fuel_lbl", type: "label", x: 40, y: 420, w: 300, h: 36, text: "FUEL", align: "left", color: "muted" },
    { id: "fuel", type: "bar_gauge", x: 40, y: 462, w: 420, h: 62, bind: "fuel", max: 100,
      style: { face: "#121418" }, zones: [ { to: 12, color: "danger" } ] },

    // Center tach
    { id: "tach", type: "analog_gauge", x: 510, y: 70, w: 580, h: 580, indicator: "arc", hub: true,
      bind: { signal: "rpm", scale: 0.001, smoothing: 0.045 },
      max: { signal: "rpm_max", scale: 0.001, ceil_to: 1, fallback: 8 }, minor_ticks: 4,
      zones: [ { from: { signal: "rpm_max", scale: 0.00092, fallback: 7.36 }, color: "danger" } ],
      caption: "×1000 RPM", center: { bind: "gear", format: { style: "gear", unit: "" } } },

    // Right: speed and race
    { id: "speed", type: "readout", x: 1130, y: 110, w: 430, h: 200, bind: "speed", align: "right",
      style: { font_scale: 1.1 } },
    { id: "pos", type: "readout", x: 1130, y: 340, w: 200, h: 110, bind: "race_position", label: "POSITION", align: "right" },
    { id: "lap_no", type: "readout", x: 1360, y: 340, w: 200, h: 110, bind: "lap_number", label: "LAP", align: "right" },
    { id: "torque", type: "readout", x: 1130, y: 470, w: 430, h: 105, bind: "torque", label: "TORQUE", align: "right" },
    { id: "rpm", type: "readout", x: 1130, y: 588, w: 430, h: 100, bind: "rpm", label: "RPM", align: "right",
      format: { unit: "" }, style: { ink: "accent" } },

    // Lamps
    { id: "abs", type: "lamp", x: 40, y: 600, w: 96, h: 50, bind: "abs_active", icon: "ABS" },
    { id: "tc", type: "lamp", x: 148, y: 600, w: 96, h: 50, bind: "tc_active", icon: "TC" },
    { id: "hb", type: "lamp", x: 256, y: 600, w: 96, h: 50, bind: "handbrake", above: 10, icon: "HB", color: "danger" },
    { id: "pit", type: "lamp", x: 364, y: 600, w: 96, h: 50, bind: "pit_limiter", icon: "PIT", color: "info" },

    // Timing strip
    { id: "strip", type: "panel", x: 0, y: 700, w: 1600, h: 200, z: -1, variant: "strip", style: { face: "#ffc414" } },
    { id: "last", type: "readout", x: 50, y: 720, w: 460, h: 150, bind: "last_lap", label: "LAST LAP", align: "left",
      format: { style: "time" }, style: { ink: "#0b0b0b", muted: "#3d3000" } },
    { id: "lap", type: "readout", x: 570, y: 720, w: 460, h: 150, bind: "lap_time", label: "CURRENT",
      format: { style: "time" }, style: { ink: "#0b0b0b", muted: "#3d3000" } },
    { id: "best", type: "readout", x: 1090, y: 720, w: 460, h: 150, bind: "best_lap", label: "BEST LAP", align: "right",
      format: { style: "time" }, style: { ink: "#0b0b0b", muted: "#3d3000" } },
  ],
}
