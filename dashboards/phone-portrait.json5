// Phone portrait — strong numeric hierarchy for a phone mounted next to the wheel.
{
  name: "Phone portrait",
  version: 1,
  description: "Tall layout for phones: shift lights, gear, speed, laps.",
  canvas: { width: 720, height: 1560 },
  theme: {
    ink: "#f4f7ff", muted: "#a9bdd6", accent: "#55d8ff", danger: "#ff3f57",
    warn: "#ffd135", ok: "#2cf18a", info: "#65adff", face: "#111925", edge: "#394e6b",
  },
  background: { color: "#182437", gradient_to: "#070b13", gradient_angle: 155 },
  widgets: [
    { id: "drive_panel", type: "panel", x: 28, y: 190, w: 664, h: 709, z: -1,
      style: { face: "#0a111c", edge: "#4874a0" } },
    { id: "timing_panel", type: "panel", x: 28, y: 921, w: 392, h: 365, z: -1 },
    { id: "inputs_panel", type: "panel", x: 438, y: 921, w: 254, h: 365, z: -1 },
    { id: "vitals_panel", type: "panel", x: 28, y: 1308, w: 664, h: 220, z: -1 },
    { id: "shift", type: "shift_lights", x: 42, y: 34, w: 636, h: 69, segments: 10,
      start: { signal: "rpm_max", scale: 0.72 }, limit: { signal: "rpm_max", scale: 0.95 }, flash_color: "#ffffff" },
    { id: "rpm_bar", type: "bar_gauge", x: 42, y: 126, w: 636, h: 30, bind: "rpm",
      max: { signal: "rpm_max", fallback: 8000 }, show_value: false, style: { accent: "#eff5ff" },
      zones: [ { from: { signal: "rpm_max", scale: 0.92 }, color: "danger" } ] },

    { id: "gear_title", type: "label", x: 150, y: 228, w: 420, h: 54, text: "GEAR", color: "muted" },
    { id: "gear", type: "gear", x: 133, y: 282, w: 454, h: 350, shift_at: { signal: "rpm_max", scale: 0.95 },
      style: { accent: "danger" } },
    { id: "speed", type: "readout", x: 100, y: 657, w: 520, h: 193, bind: "speed", label: "SPEED",
      style: { font_scale: 1.28 } },

    { id: "lap", type: "lap_timer", x: 55, y: 976, w: 333, h: 282 },
    { id: "pedals", type: "pedals", x: 459, y: 966, w: 212, h: 279, style: { face: "#0b131f", font_scale: 1.25 } },
    { id: "fuel", type: "bar_gauge", x: 53, y: 1342, w: 614, h: 59, label: "FUEL", bind: "fuel", max: 100,
      style: { face: "#0b131f", accent: "#285d93" }, zones: [ { to: 10, color: "danger" } ] },
    { id: "boost", type: "bar_gauge", x: 53, y: 1432, w: 614, h: 59, label: "BOOST", bind: "boost",
      min: 0, max: 1.5, format: { decimals: 2 }, style: { face: "#0b131f", accent: "#285d93" } },
  ],
}
