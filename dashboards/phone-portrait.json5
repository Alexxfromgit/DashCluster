// Phone portrait — strong numeric hierarchy for a phone mounted next to the wheel.
{
  name: "Phone portrait",
  version: 1,
  description: "Tall layout for phones: shift lights, gear, speed, laps.",
  canvas: { width: 720, height: 1560 },
  theme: {
    ink: "#f4f7fb", muted: "#97a6b8", accent: "#4fd6ff", danger: "#ff3350",
    warn: "#ffd02e", ok: "#36ef7a", info: "#4fb0ff", face: "#0a0d12", edge: "#2a323e",
    unit: "#4fd6ff",
  },
  background: { color: "#020304" },
  widgets: [
    { id: "shift", type: "shift_lights", x: 30, y: 30, w: 660, h: 66, segments: 10,
      start: { signal: "rpm_max", scale: 0.72 }, limit: { signal: "rpm_max", scale: 0.95 }, flash_color: "#ffffff" },
    { id: "rpm_bar", type: "bar_gauge", x: 40, y: 118, w: 640, h: 26, bind: "rpm",
      max: { signal: "rpm_max", fallback: 8000 }, show_value: false, style: { accent: "#e9eef5", face: "#0d1117" },
      zones: [ { from: { signal: "rpm_max", scale: 0.92 }, color: "danger" } ] },

    { id: "gear", type: "gear", x: 110, y: 180, w: 500, h: 470, frame: "hex",
      shift_at: { signal: "rpm_max", scale: 0.95 }, style: { accent: "danger", edge: "#3a4656" } },
    { id: "speed", type: "readout", x: 60, y: 676, w: 600, h: 210, bind: "speed", label: "SPEED",
      label_position: "below", style: { font_scale: 1.15 } },

    { id: "mid", type: "panel", x: 30, y: 914, w: 660, h: 380, z: -1, variant: "divider", edges: ["top", "bottom"],
      style: { face: "transparent" } },
    { id: "lap", type: "lap_timer", x: 50, y: 944, w: 400, h: 320, layout: "columns" },
    { id: "pedals", type: "pedals", x: 470, y: 944, w: 210, h: 320, show_values: true,
      style: { face: "#0d1117", font_scale: 1.25 } },

    { id: "fuel", type: "bar_gauge", x: 40, y: 1324, w: 640, h: 70, label: "FUEL", bind: "fuel", max: 100,
      style: { face: "#0d1117", accent: "#1f7fa3" }, zones: [ { to: 10, color: "danger" } ] },
    { id: "boost", type: "bar_gauge", x: 40, y: 1414, w: 640, h: 70, label: "BOOST", bind: "boost",
      min: 0, max: 1.5, format: { decimals: 2 }, style: { face: "#0d1117", accent: "#1f7fa3" } },
    { id: "strip", type: "panel", x: 0, y: 1508, w: 720, h: 52, z: -1, variant: "strip", style: { face: "#0e1218" } },
    { id: "pos", type: "label", x: 30, y: 1516, w: 330, h: 36, text: "P{race_position} · LAP {lap_number}",
      align: "left", color: "muted" },
    { id: "best", type: "label", x: 360, y: 1516, w: 330, h: 36, text: "BEST {best_lap:time}", align: "right", color: "muted" },
  ],
}
