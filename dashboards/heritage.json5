// Heritage — white faces and red needles on a dark twin-dial cluster.
{
  name: "Heritage",
  description: "White analogue speedometer and tachometer with red needles and a central gear indicator.",
  canvas: { width: 1600, height: 900 },
  theme: {
    ink: "#f3f6fb", muted: "#9aa6b6", accent: "#ff4355", danger: "#ff4355",
    warn: "#ffcb35", ok: "#3cf18a", info: "#68a9ff", face: "#0c1016", edge: "#3a4452",
  },
  background: { color: "#07090c", gradient_to: "#12161d", gradient_angle: 180 },
  widgets: [
    { id: "speedo", type: "analog_gauge", x: 43, y: 110, w: 540, h: 540,
      bind: { signal: "speed", smoothing: 0.08 }, max: 280, major_ticks: 7, minor_ticks: 4,
      style: { ink: "#172231", muted: "#48596e", face: "#eef2f6", edge: "#8a96a4", accent: "#c3152b", unit: "#48596e" } },
    { id: "tach", type: "analog_gauge", x: 1017, y: 110, w: 540, h: 540,
      bind: { signal: "rpm", scale: 0.001, smoothing: 0.04 },
      max: { signal: "rpm_max", scale: 0.001, ceil_to: 1, fallback: 8 },
      zones: [ { from: { signal: "rpm_max", scale: 0.00090, fallback: 7.2 }, color: "#c3152b" } ],
      caption: "×1000 r/min", center: { bind: "rpm", format: { unit: "" } },
      style: { ink: "#172231", muted: "#48596e", face: "#eef2f6", edge: "#8a96a4", accent: "#c3152b" } },

    { id: "center_panel", type: "panel", x: 620, y: 170, w: 360, h: 420, z: -1, variant: "chamfer",
      style: { face: "#0a0d12", edge: "#4a5566" } },
    { id: "gear_title", type: "label", x: 660, y: 196, w: 280, h: 40, text: "GEAR", color: "muted" },
    { id: "gear", type: "gear", x: 660, y: 240, w: 280, h: 240, shift_at: { signal: "rpm_max", scale: 0.94 } },
    { id: "shift", type: "shift_lights", x: 660, y: 508, w: 280, h: 46, segments: 8,
      start: { signal: "rpm_max", scale: 0.70 }, limit: { signal: "rpm_max", scale: 0.96 },
      colors: ["warn", "warn", "warn", "warn", "warn", "danger"], flash_color: "#ffffff" },

    { id: "row", type: "panel", x: 40, y: 704, w: 1520, h: 160, z: -1, variant: "divider", edges: ["top"],
      style: { face: "transparent", edge: "#2f3742" } },
    { id: "power", type: "readout", x: 75, y: 730, w: 288, h: 110, bind: "power", label: "POWER" },
    { id: "torque", type: "readout", x: 450, y: 730, w: 288, h: 110, bind: "torque", label: "TORQUE" },
    { id: "distance", type: "readout", x: 829, y: 730, w: 288, h: 110, bind: "distance", label: "DISTANCE",
      format: { decimals: 1 } },
    { id: "fuel", type: "readout", x: 1205, y: 730, w: 288, h: 110, bind: "fuel", label: "FUEL",
      zones: [ { to: 12, color: "warn" } ] },
  ],
}
