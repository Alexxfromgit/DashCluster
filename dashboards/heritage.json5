// White faces and red needles on a dark twin-dial cluster.
{
  name: "Heritage",
  description: "White analogue speedometer and tachometer with red needles and a central gear indicator.",
  canvas: { width: 1600, height: 900 },
  theme: {
    ink: "#f3f6fb", muted: "#b3becc", accent: "#ff4355", danger: "#ff4355",
    warn: "#ffcb35", ok: "#3cf18a", info: "#68a9ff", face: "#151b24", edge: "#404b5a",
  },
  background: { color: "#242c38", gradient_to: "#080b11", gradient_angle: 155 },
  widgets: [
    { id: "center_panel", type: "panel", x: 610, y: 185, w: 380, h: 432, z: -1,
      style: { face: "#0d131d", edge: "#455267" } },
    { id: "footer_panel", type: "panel", x: 37, y: 708, w: 1526, h: 156, z: -1 },
    { id: "speedo", type: "analog_gauge", x: 43, y: 133, w: 529, h: 529,
      bind: { signal: "speed", smoothing: 0.08 }, max: 280, major_ticks: 7, minor_ticks: 4,
      style: { ink: "#172231", muted: "#48596e", face: "#edf2f7", edge: "#788898", accent: "#c3152b" } },
    { id: "tach", type: "analog_gauge", x: 1028, y: 133, w: 529, h: 529,
      bind: { signal: "rpm", scale: 0.001, smoothing: 0.04 },
      max: { signal: "rpm_max", scale: 0.001, ceil_to: 1, fallback: 8 },
      zones: [ { from: { signal: "rpm_max", scale: 0.00090, fallback: 7.2 }, color: "#c3152b" } ],
      caption: "×1000 r/min", center: { bind: "rpm", format: { unit: "" } },
      style: { ink: "#172231", muted: "#48596e", face: "#edf2f7", edge: "#788898", accent: "#c3152b" } },
    { id: "gear_title", type: "label", x: 663, y: 221, w: 274, h: 51, text: "GEAR", color: "muted" },
    { id: "gear", type: "gear", x: 663, y: 274, w: 274, h: 222, shift_at: { signal: "rpm_max", scale: 0.94 } },
    { id: "shift", type: "shift_lights", x: 661, y: 530, w: 278, h: 48, segments: 8,
      start: { signal: "rpm_max", scale: 0.70 }, limit: { signal: "rpm_max", scale: 0.96 },
      colors: ["warn", "warn", "warn", "warn", "warn", "danger"], flash_color: "#ffffff" },
    { id: "power", type: "readout", x: 75, y: 740, w: 288, h: 89, bind: "power", label: "POWER" },
    { id: "torque", type: "readout", x: 450, y: 740, w: 288, h: 89, bind: "torque", label: "TORQUE" },
    { id: "distance", type: "readout", x: 829, y: 740, w: 288, h: 89, bind: "distance", label: "DISTANCE",
      format: { decimals: 1 } },
    { id: "fuel", type: "readout", x: 1205, y: 740, w: 288, h: 89, bind: "fuel", label: "FUEL",
      zones: [ { to: 12, color: "warn" } ] },
  ],
}
