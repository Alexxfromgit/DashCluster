// Pit-wall layout with track position, lap timing and tyre temperatures around a gear tower.
{
  name: "Endurance",
  description: "Gear and speed in the center, with tyre temperatures, lap timing and driver inputs on either side.",
  canvas: { width: 1600, height: 900 },
  theme: {
    ink: "#f2f8ff", muted: "#a9bfda", accent: "#48e2f4", danger: "#ff4355",
    warn: "#ffcc34", ok: "#29f18a", info: "#54a7ff", face: "#0d1827", edge: "#385470",
  },
  background: { color: "#1c2b3f", gradient_to: "#070b14", gradient_angle: 145 },
  widgets: [
    { id: "shift_panel", type: "panel", x: 32, y: 32, w: 1536, h: 106, z: -1 },
    { id: "tyre_panel", type: "panel", x: 32, y: 160, w: 445, h: 480, z: -1 },
    { id: "fuel_panel", type: "panel", x: 32, y: 660, w: 445, h: 208, z: -1 },
    { id: "drive_panel", type: "panel", x: 500, y: 160, w: 434, h: 708, z: -1,
      style: { face: "#08121f", edge: "#3880a0" } },
    { id: "timing_panel", type: "panel", x: 956, y: 160, w: 612, h: 410, z: -1 },
    { id: "inputs_panel", type: "panel", x: 956, y: 590, w: 612, h: 278, z: -1 },
    { id: "position", type: "label", x: 58, y: 55, w: 150, h: 58, text: "P{race_position}",
      align: "left", color: "accent" },
    { id: "shift", type: "shift_lights", x: 245, y: 51, w: 1110, h: 68, segments: 16,
      start: { signal: "rpm_max", scale: 0.68 }, limit: { signal: "rpm_max", scale: 0.97 },
      colors: ["ok", "ok", "ok", "ok", "ok", "ok", "warn", "warn", "warn", "warn", "warn", "danger"],
      flash_color: "#ffffff" },
    { id: "handbrake", type: "lamp", x: 1412, y: 57, w: 128, h: 56,
      bind: "handbrake", above: 10, icon: "HB", color: "danger" },
    { id: "tyres", type: "tyre_quad", x: 58, y: 203, w: 393, h: 392, label: "TYRE TEMP", show_unit: true,
      zones: [ { to: 65, color: "info" }, { from: 65, to: 100, color: "ok" }, { from: 100, color: "danger" } ] },
    { id: "fuel", type: "readout", x: 61, y: 684, w: 386, h: 106, bind: "fuel", label: "FUEL REMAINING",
      zones: [ { to: 12, color: "warn" } ] },
    { id: "fuel_bar", type: "bar_gauge", x: 61, y: 808, w: 386, h: 23, bind: "fuel", max: 100,
      show_value: false, zones: [ { to: 12, color: "warn" } ] },
    { id: "rpm", type: "readout", x: 532, y: 200, w: 370, h: 122, bind: "rpm", label: "RPM",
      style: { ink: "accent" }, format: { unit: "" } },
    { id: "gear_title", type: "label", x: 532, y: 341, w: 370, h: 45, text: "GEAR", color: "muted" },
    { id: "gear", type: "gear", x: 583, y: 390, w: 267, h: 259, style: { accent: "danger" },
      shift_at: { signal: "rpm_max", scale: 0.95 } },
    { id: "speed", type: "readout", x: 527, y: 676, w: 380, h: 145, bind: "speed", label: "SPEED" },
    { id: "laps", type: "lap_timer", x: 992, y: 205, w: 536, h: 342 },
    { id: "inputs", type: "label", x: 992, y: 619, w: 536, h: 46, text: "DRIVER INPUTS", color: "muted" },
    { id: "pedals", type: "pedals", x: 993, y: 686, w: 536, h: 146,
      signals: ["throttle", "brake", "clutch"], style: { face: "#1c2b3f", font_scale: 2.1 } },
  ],
}
