// Endurance — boxed pit-wall layout: car tyre map, seven-segment gear tower, timing and inputs.
{
  name: "Endurance",
  description: "Tyre map, digital gear and speed, lap timing, fuel, status lamps and driver inputs.",
  canvas: { width: 1600, height: 900 },
  theme: {
    ink: "#f2f6fa", muted: "#9fb0c2", accent: "#7dff4a", danger: "#ff3d4f",
    warn: "#ffd31f", ok: "#59f06c", info: "#3fb4ff", face: "#05070a", edge: "#3b4552",
    unit: "#7c8b9c",
  },
  background: { color: "#000000" },
  widgets: [
    { id: "shift", type: "shift_lights", x: 300, y: 18, w: 1000, h: 50, segments: 16,
      start: { signal: "rpm_max", scale: 0.68 }, limit: { signal: "rpm_max", scale: 0.97 },
      colors: ["#ff3355", "#ff3355", "#c44dff", "#c44dff", "#6b6bff", "#6b6bff", "#3f9dff", "#3f9dff",
        "#3f9dff", "#3f9dff", "#6b6bff", "#6b6bff", "#c44dff", "#c44dff", "#ff3355", "#ff3355"],
      flash_color: "#ffffff" },

    // Left column
    { id: "tyre_box", type: "panel", x: 30, y: 90, w: 480, h: 440, z: -1 },
    { id: "tyres", type: "tyre_quad", x: 50, y: 110, w: 440, h: 400, layout: "car", label: "TYRE TEMP", show_unit: true,
      zones: [ { to: 65, color: "info" }, { from: 65, to: 100, color: "ok" }, { from: 100, color: "danger" } ] },
    { id: "fuel_box", type: "panel", x: 30, y: 548, w: 480, h: 156, z: -1, title: "FUEL" },
    { id: "fuel", type: "readout", x: 54, y: 590, w: 200, h: 96, bind: "fuel", align: "left",
      zones: [ { to: 12, color: "warn" } ], style: { font: "digital" } },
    { id: "fuel_bar", type: "bar_gauge", x: 270, y: 620, w: 214, h: 34, bind: "fuel", max: 100, show_value: false,
      style: { face: "#0d1117", accent: "ok" }, zones: [ { to: 12, color: "warn" } ] },
    { id: "status_box", type: "panel", x: 30, y: 722, w: 480, h: 156, z: -1, title: "STATUS" },
    { id: "abs", type: "lamp", x: 54, y: 776, w: 80, h: 52, bind: "abs_active", icon: "ABS" },
    { id: "tc", type: "lamp", x: 144, y: 776, w: 80, h: 52, bind: "tc_active", icon: "TC" },
    { id: "hb", type: "lamp", x: 234, y: 776, w: 80, h: 52, bind: "handbrake", above: 10, icon: "HB", color: "danger" },
    { id: "pit", type: "lamp", x: 324, y: 776, w: 80, h: 52, bind: "pit_limiter", icon: "PIT", color: "info" },
    { id: "lights", type: "lamp", x: 414, y: 776, w: 72, h: 52, bind: "lights", icon: "◐", color: "ok" },

    // Center: digital gear tower
    { id: "drive_box", type: "panel", x: 530, y: 90, w: 360, h: 788, z: -1, style: { edge: "#8a98a8" } },
    { id: "rpm", type: "readout", x: 550, y: 104, w: 320, h: 104, bind: "rpm", format: { unit: "" },
      style: { font: "digital" } },
    { id: "rpm_line", type: "panel", x: 545, y: 218, w: 330, h: 2, z: -1, variant: "strip", style: { face: "#8a98a8" } },
    { id: "gear_label", type: "label", x: 552, y: 230, w: 120, h: 34, text: "GEAR", align: "left", color: "muted" },
    { id: "gear", type: "gear", x: 560, y: 268, w: 300, h: 300, shift_at: { signal: "rpm_max", scale: 0.95 },
      style: { accent: "danger", font: "digital" } },
    { id: "speed_label", type: "label", x: 552, y: 590, w: 120, h: 34, text: "SPEED", align: "left", color: "muted" },
    { id: "speed", type: "readout", x: 550, y: 628, w: 320, h: 140, bind: "speed",
      style: { font: "digital" } },
    { id: "rpm_bar", type: "bar_gauge", x: 552, y: 800, w: 316, h: 28, bind: "rpm", show_value: false,
      max: { signal: "rpm_max", fallback: 8000 }, style: { face: "#0d1117", accent: "warn" },
      zones: [ { from: { signal: "rpm_max", scale: 0.92 }, color: "danger" } ] },

    // Right: timing and inputs
    { id: "timing_box", type: "panel", x: 910, y: 90, w: 660, h: 440, z: -1 },
    { id: "pos", type: "readout", x: 934, y: 112, w: 200, h: 120, bind: "race_position", label: "POS",
      align: "left", style: { font: "digital" } },
    { id: "lap_no", type: "readout", x: 934, y: 250, w: 200, h: 120, bind: "lap_number", label: "LAP",
      align: "left", style: { font: "digital" } },
    { id: "fuel_lap", type: "readout", x: 934, y: 388, w: 200, h: 120, bind: "boost", label: "BOOST",
      align: "left", format: { decimals: 2 }, style: { font: "digital" } },
    { id: "timing_div", type: "panel", x: 1150, y: 110, w: 2, h: 400, z: -1, variant: "strip", style: { face: "#3b4552" } },
    { id: "laps", type: "lap_timer", x: 1174, y: 114, w: 376, h: 390, layout: "columns",
      style: { font: "digital", font_scale: 0.95 } },

    { id: "inputs_box", type: "panel", x: 910, y: 548, w: 660, h: 330, z: -1, title: "INPUTS" },
    { id: "pedals", type: "pedals", x: 934, y: 620, w: 300, h: 244, show_values: true,
      style: { face: "#0d1117", font_scale: 1.3 } },
    { id: "g", type: "g_meter", x: 1268, y: 574, w: 280, h: 280, max_g: 2, style: { face: "#05070a" } },
  ],
}
