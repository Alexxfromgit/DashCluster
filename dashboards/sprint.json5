// Sprint — data-logger look: big gear, rising RPM graph, white numerals and a status strip.
{
  name: "Sprint",
  description: "Big gear and RPM graph with speed, lap timing and engine readouts.",
  canvas: { width: 1440, height: 810 },
  theme: {
    ink: "#ffffff", muted: "#ffffff", accent: "#ffffff", danger: "#ff2a3a",
    warn: "#ffd23a", ok: "#4af07e", info: "#3fb5ff", face: "#0d0f12", edge: "#23272d",
    unit: "#3fb5ff",
  },
  background: { color: "#000000" },
  widgets: [
    { id: "shift", type: "shift_lights", x: 470, y: 14, w: 500, h: 40, segments: 10, shape: "bar",
      start: { signal: "rpm_max", scale: 0.72 }, limit: { signal: "rpm_max", scale: 0.96 },
      colors: ["ok", "ok", "warn", "warn", "danger", "danger", "warn", "warn", "ok", "ok"], flash_color: "#ffffff" },

    { id: "gear", type: "gear", x: 30, y: 54, w: 270, h: 230, shift_at: { signal: "rpm_max", scale: 0.94 },
      style: { accent: "danger", font_scale: 1.12 } },
    { id: "speed", type: "readout", x: 520, y: 66, w: 400, h: 150, bind: "speed", label: "SPEED",
      label_position: "below", align: "right", style: { muted: "#ff9e1b" } },
    { id: "rpm", type: "readout", x: 960, y: 66, w: 450, h: 150, bind: "rpm", label: "RPM",
      label_position: "below", align: "right", format: { unit: "" }, style: { muted: "#ff9e1b" } },

    { id: "tach", type: "bar_gauge", x: 30, y: 292, w: 1380, h: 256, shape: "curve", show_value: false,
      bind: { signal: "rpm", scale: 0.001, smoothing: 0.04 },
      max: { signal: "rpm_max", scale: 0.001, ceil_to: 1, fallback: 8 },
      style: { face: "#101318", edge: "#2a2f37" },
      zones: [ { from: { signal: "rpm_max", scale: 0.00092, fallback: 7.36 }, color: "danger" } ] },

    { id: "lap_no", type: "readout", x: 30, y: 560, w: 220, h: 96, bind: "lap_number", label: "LAP",
      label_position: "below", align: "right" },
    { id: "lap", type: "readout", x: 300, y: 560, w: 520, h: 96, bind: "lap_time", label: "LAP TIME",
      label_position: "below", align: "right", format: { style: "time" } },
    { id: "best", type: "readout", x: 890, y: 560, w: 520, h: 96, bind: "best_lap", label: "BEST LAP",
      label_position: "below", align: "right", format: { style: "time" } },

    { id: "fuel", type: "readout", x: 30, y: 660, w: 420, h: 96, bind: "fuel", label: "FUEL",
      label_position: "below", align: "right", zones: [ { to: 12, color: "warn" } ] },
    { id: "boost", type: "readout", x: 500, y: 660, w: 420, h: 96, bind: "boost", label: "BOOST",
      label_position: "below", align: "right", format: { decimals: 2 } },
    { id: "power", type: "readout", x: 990, y: 660, w: 420, h: 96, bind: "power", label: "POWER",
      label_position: "below", align: "right" },

    { id: "strip", type: "panel", x: 30, y: 760, w: 1380, h: 40, z: -1, variant: "strip",
      title: "TELEMETRY: LIVE", style: { face: "#8db7d8", muted: "#0a1622" } },
    { id: "clock", type: "label", x: 1000, y: 764, w: 390, h: 32, text: "{race_time:time}", align: "right",
      color: "#0a1622" },
  ],
}
