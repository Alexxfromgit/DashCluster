// Wide rising RPM strip and oversized gear and speed for a quick glance.
{
  name: "Sprint",
  description: "Rising RPM strip with large gear and speed, lap times and fuel.",
  canvas: { width: 1440, height: 810 },
  theme: {
    ink: "#eff4ff", muted: "#a9bbd4", accent: "#f1f5ff", danger: "#ff4056",
    warn: "#ffc82d", ok: "#32f38f", info: "#4bcbff", face: "#121b28", edge: "#384b63",
  },
  background: { color: "#080c14", gradient_to: "#1b273b", gradient_angle: 145 },
  widgets: [
    { id: "main_panel", type: "panel", x: 32, y: 32, w: 1376, h: 550, z: -1,
      style: { face: "#0c131f", edge: "#465f80" } },
    { id: "timing_panel", type: "panel", x: 32, y: 604, w: 1376, h: 174, z: -1 },
    { id: "shift", type: "shift_lights", x: 460, y: 60, w: 520, h: 53, segments: 12,
      start: { signal: "rpm_max", scale: 0.72 }, limit: { signal: "rpm_max", scale: 0.96 }, flash_color: "#ffffff" },
    { id: "gear_title", type: "label", x: 65, y: 132, w: 238, h: 42, text: "GEAR", color: "muted" },
    { id: "gear", type: "gear", x: 65, y: 185, w: 238, h: 162, style: { ink: "accent", accent: "danger" },
      shift_at: { signal: "rpm_max", scale: 0.94 } },
    { id: "speed", type: "readout", x: 468, y: 132, w: 504, h: 211, bind: "speed", label: "SPEED", style: { font_scale: 1.28 } },
    { id: "rpm", type: "readout", x: 1038, y: 144, w: 305, h: 181, bind: "rpm", label: "RPM", align: "right", format: { unit: "" } },
    { id: "tach", type: "bar_gauge", x: 69, y: 379, w: 1302, h: 142, bind: { signal: "rpm", smoothing: 0.04 },
      max: { signal: "rpm_max", fallback: 8000 }, show_value: false, ramp_segments: 40,
      zones: [ { from: { signal: "rpm_max", scale: 0.80, fallback: 6400 }, to: { signal: "rpm_max", scale: 0.91, fallback: 7280 }, color: "warn" },
        { from: { signal: "rpm_max", scale: 0.91, fallback: 7280 }, color: "danger" } ] },
    { id: "rpm_min", type: "label", x: 69, y: 535, w: 140, h: 28, text: "0 RPM", align: "left", color: "muted" },
    { id: "rpm_limit", type: "label", x: 1177, y: 535, w: 187, h: 28, text: "{rpm_max} RPM", align: "right", color: "muted" },
    { id: "lap_number", type: "readout", x: 62, y: 626, w: 190, h: 116, bind: "lap_number", label: "LAP" },
    { id: "lap", type: "readout", x: 266, y: 626, w: 340, h: 116, bind: "lap_time", label: "LAP TIME",
      format: { style: "time" } },
    { id: "best", type: "readout", x: 620, y: 626, w: 340, h: 116, bind: "best_lap", label: "BEST LAP",
      format: { style: "time" }, style: { ink: "info" } },
    { id: "fuel", type: "readout", x: 1010, y: 625, w: 332, h: 89, bind: "fuel", label: "FUEL",
      zones: [ { to: 12, color: "warn" } ] },
    { id: "fuel_bar", type: "bar_gauge", x: 1028, y: 729, w: 296, h: 19, bind: "fuel", max: 100,
      show_value: false, style: { accent: "#3e9af9" }, zones: [ { to: 12, color: "warn" } ] },
  ],
}
