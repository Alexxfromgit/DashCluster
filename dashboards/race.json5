// Race — twin illuminated dials framed by engine readouts, with timing and a gain/loss bar below.
{
  name: "Race",
  version: 1,
  description: "Lime twin arcs for speed and RPM, gear in the hub, timing row and a long-g bar.",
  canvas: { width: 1600, height: 900 },
  theme: {
    ink: "#f4f6f8", muted: "#9aa4b0", accent: "#c8ff1e", danger: "#ff2e48",
    warn: "#ffc21a", ok: "#3cf07c", info: "#3bb8ff", face: "#0a0c10", edge: "#272d36",
  },
  background: { color: "#030405" },
  widgets: [
    // Frame
    { id: "left_col", type: "panel", x: 30, y: 100, w: 300, h: 470, z: -1, variant: "divider", edges: ["right"],
      style: { face: "transparent" } },
    { id: "right_col", type: "panel", x: 1270, y: 100, w: 300, h: 470, z: -1, variant: "divider", edges: ["left"],
      style: { face: "transparent" } },
    { id: "timing_row", type: "panel", x: 30, y: 590, w: 1540, h: 240, z: -1, variant: "divider", edges: ["top"],
      style: { face: "transparent" } },
    { id: "footer", type: "panel", x: 0, y: 846, w: 1600, h: 54, z: -1, variant: "strip",
      style: { face: "#101318" } },

    // Top bar
    { id: "pos", type: "label", x: 40, y: 22, w: 150, h: 54, text: "P{race_position}", align: "left", color: "accent" },
    { id: "shift", type: "shift_lights", x: 450, y: 22, w: 700, h: 52, segments: 14,
      start: { signal: "rpm_max", scale: 0.72 }, limit: { signal: "rpm_max", scale: 0.95 },
      colors: ["ok", "ok", "ok", "ok", "ok", "warn", "warn", "warn", "warn", "danger", "danger", "danger", "#b44dff"],
      flash_color: "#ffffff" },
    { id: "hb", type: "lamp", x: 1320, y: 26, w: 110, h: 44, bind: "handbrake", above: 10, icon: "HB", color: "danger" },
    { id: "slip", type: "lamp", x: 1450, y: 26, w: 110, h: 44, bind: "slip_rr", above: 100, icon: "SLIP", blink: true },

    // Left column: engine
    { id: "rpm", type: "readout", x: 40, y: 112, w: 270, h: 104, bind: "rpm", label: "RPM",
      align: "right", format: { unit: "" }, style: { ink: "accent" } },
    { id: "boost", type: "readout", x: 40, y: 222, w: 270, h: 104, bind: "boost", label: "BOOST",
      align: "right", format: { decimals: 2 } },
    { id: "power", type: "readout", x: 40, y: 332, w: 270, h: 104, bind: "power", label: "POWER", align: "right" },
    { id: "torque", type: "readout", x: 40, y: 442, w: 270, h: 104, bind: "torque", label: "TORQUE", align: "right" },

    // Dials
    { id: "speedo", type: "analog_gauge", x: 350, y: 100, w: 450, h: 450, indicator: "arc", hub: true,
      bind: { signal: "speed", smoothing: 0.08 }, max: 320, major_ticks: 8, minor_ticks: 2,
      center: { bind: "speed", show_unit: true }, caption: "SPEED" },
    { id: "tach", type: "analog_gauge", x: 800, y: 100, w: 450, h: 450, indicator: "arc", hub: true,
      bind: { signal: "rpm", scale: 0.001, smoothing: 0.045 },
      max: { signal: "rpm_max", scale: 0.001, ceil_to: 1, fallback: 8 }, minor_ticks: 2,
      zones: [ { from: { signal: "rpm_max", scale: 0.00092, fallback: 7.36 }, color: "danger" } ],
      caption: "GEAR", center: { bind: "gear", format: { style: "gear", unit: "" } } },

    // Right column: chassis
    { id: "tyres", type: "tyre_quad", x: 1290, y: 110, w: 270, h: 280, layout: "car", label: "TYRES", show_unit: true,
      zones: [ { to: 65, color: "info" }, { from: 65, to: 100, color: "ok" }, { from: 100, color: "danger" } ] },
    { id: "pedals", type: "pedals", x: 1300, y: 400, w: 250, h: 160, show_values: true, style: { font_scale: 1.6 } },

    // Timing row
    { id: "best", type: "readout", x: 50, y: 610, w: 420, h: 112, bind: "best_lap", label: "BEST",
      align: "left", format: { style: "time" } },
    { id: "last", type: "readout", x: 50, y: 740, w: 420, h: 90, bind: "last_lap", label: "LAST",
      align: "left", format: { style: "time" }, style: { muted: "#6d7782" } },
    { id: "long_g", type: "readout", x: 640, y: 606, w: 320, h: 104, bind: "accel_long", label: "LONG G",
      format: { decimals: 2 } },
    { id: "gain", type: "bar_gauge", x: 480, y: 728, w: 640, h: 26, bind: { signal: "accel_long", smoothing: 0.1 },
      shape: "center", min: -1.5, max: 1.5, show_value: false,
      zones: [ { to: 0, color: "danger" }, { from: 0, color: "ok" } ] },
    { id: "brake_lbl", type: "label", x: 480, y: 760, w: 200, h: 34, text: "BRAKING", align: "left", color: "muted" },
    { id: "accel_lbl", type: "label", x: 920, y: 760, w: 200, h: 34, text: "ACCEL", align: "right", color: "muted" },
    { id: "lap", type: "readout", x: 1130, y: 610, w: 420, h: 112, bind: "lap_time", label: "LAP TIME",
      align: "right", format: { style: "time" } },
    { id: "fuel", type: "bar_gauge", x: 1240, y: 752, w: 310, h: 46, label: "FUEL", bind: "fuel", max: 100,
      style: { face: "#111419", accent: "#8fb814" }, zones: [ { to: 10, color: "danger" } ] },

    // Footer
    { id: "lap_no", type: "label", x: 40, y: 856, w: 400, h: 34, text: "LAP {lap_number}", align: "left", color: "muted" },
    { id: "race_time", type: "label", x: 600, y: 856, w: 400, h: 34, text: "RACE {race_time:time}", color: "muted" },
    { id: "dist", type: "label", x: 1160, y: 856, w: 400, h: 34, text: "POS {race_position}", align: "right", color: "muted" },
  ],
}
