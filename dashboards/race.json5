// Race — timing, inputs, gear and chassis telemetry in a high-contrast layout.
{
  name: "Race",
  version: 1,
  description: "Shift lights, big gear, lap timing, tyres and inputs.",
  canvas: { width: 1600, height: 900 },
  theme: {
    ink: "#f3f7ff", muted: "#aabbd1", accent: "#57c7ff", danger: "#ff3653",
    warn: "#ffd33d", ok: "#29ed8a", info: "#4e91ff", face: "#131b27", edge: "#394b62",
  },
  background: { color: "#1b2636", gradient_to: "#080d16", gradient_angle: 150 },
  widgets: [
    { id: "timing_panel", type: "panel", x: 26, y: 163, w: 340, h: 697, z: -1 },
    { id: "inputs_panel", type: "panel", x: 382, y: 163, w: 234, h: 697, z: -1 },
    { id: "drive_panel", type: "panel", x: 632, y: 163, w: 343, h: 697, z: -1,
      style: { face: "#0b121e", edge: "#4574a5" } },
    { id: "chassis_panel", type: "panel", x: 991, y: 163, w: 583, h: 697, z: -1 },
    { id: "shift", type: "shift_lights", x: 400, y: 35, w: 800, h: 57, segments: 15,
      start: { signal: "rpm_max", scale: 0.72 }, limit: { signal: "rpm_max", scale: 0.95 }, flash_color: "#ffffff" },
    { id: "rpm_bar", type: "bar_gauge", x: 400, y: 109, w: 800, h: 22,
      bind: "rpm", max: { signal: "rpm_max", fallback: 8000 }, show_value: false,
      zones: [ { from: { signal: "rpm_max", scale: 0.92 }, color: "danger" } ] },
    { id: "pos", type: "label", x: 48, y: 47, w: 298, h: 61, text: "P{race_position}", align: "left", color: "accent" },
    { id: "hb", type: "lamp", x: 1282, y: 44, w: 128, h: 57, bind: "handbrake", above: 10, icon: "HB", color: "danger" },
    { id: "slip", type: "lamp", x: 1429, y: 44, w: 128, h: 57, bind: "slip_rr", above: 100, icon: "SLIP", blink: true },

    { id: "lap", type: "lap_timer", x: 53, y: 248, w: 286, h: 292 },
    { id: "distance", type: "readout", x: 53, y: 709, w: 265, h: 95, bind: "distance", label: "DISTANCE",
      align: "left", format: { decimals: 1 } },
    { id: "rpm", type: "readout", x: 404, y: 219, w: 190, h: 114, label: "RPM", bind: "rpm", format: { unit: "" } },
    { id: "pedals", type: "pedals", x: 395, y: 379, w: 208, h: 419, style: { face: "#202e43" } },
    { id: "gear_title", type: "label", x: 659, y: 226, w: 289, h: 66, text: "GEAR", color: "muted" },
    { id: "gear", type: "gear", x: 660, y: 306, w: 287, h: 292,
      shift_at: { signal: "rpm_max", scale: 0.95 }, style: { accent: "danger" } },
    { id: "speed", type: "readout", x: 650, y: 642, w: 307, h: 145, bind: "speed", label: "SPEED",
      style: { font_scale: 1.2 } },

    { id: "tyres", type: "tyre_quad", x: 1017, y: 224, w: 246, h: 305, label: "TYRE TEMP", show_unit: true,
      zones: [ { to: 65, color: "info" }, { from: 65, to: 100, color: "ok" }, { from: 100, color: "danger" } ] },
    { id: "g", type: "g_meter", x: 1298, y: 244, w: 246, h: 246, max_g: 2, style: { face: "#0b121e" } },
    { id: "fuel", type: "bar_gauge", x: 1016, y: 612, w: 532, h: 51, label: "FUEL", bind: "fuel", max: 100,
      style: { face: "#0b121e", accent: "#235582" }, zones: [ { to: 10, color: "danger" } ] },
    { id: "power", type: "bar_gauge", x: 1016, y: 713, w: 532, h: 51, label: "POWER", bind: "power",
      min: 0, max: 600, style: { face: "#0b121e", accent: "#23456e" } },
  ],
}
