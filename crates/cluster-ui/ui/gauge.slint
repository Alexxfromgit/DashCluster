// Analog gauge drawn with SVG-style paths in a fixed 200x200 viewbox, so it scales
// cleanly to any size. Angles are clockwise from 12 o'clock.
export component AnalogGauge inherits Rectangle {
    in property <float> value;
    in property <float> min-value: 0;
    in property <float> max-value: 8;
    in property <float> redline: 7;
    in property <angle> start-angle: -135deg;
    in property <angle> sweep: 270deg;
    in property <int> major-ticks: 8;
    in property <int> minor-ticks: 4;
    in property <string> caption;
    in property <string> value-text;
    in property <color> face: #0d1117;
    in property <color> ink: #e6edf3;
    in property <color> accent: #ff7a1a;
    in property <color> danger: #ff3b30;

    property <length> side: min(self.width, self.height);
    property <float> frac: clamp((root.value - root.min-value) / max(0.0001, root.max-value - root.min-value), 0, 1.02);
    property <angle> needle-angle: root.start-angle + root.sweep * root.frac;
    property <float> red-frac: clamp((root.redline - root.min-value) / max(0.0001, root.max-value - root.min-value), 0, 1);

    face-disc := Rectangle {
        width: root.side;
        height: root.side;
        border-radius: self.width / 2;
        background: root.face;
        border-width: root.side * 0.012;
        border-color: #30363d;

        // Redline band
        Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
            stroke: root.danger;
            stroke-width: root.side * 0.035;
            property <angle> a0: root.start-angle + root.sweep * root.red-frac;
            property <angle> a1: root.start-angle + root.sweep;
            property <float> r: 86;
            commands: "M " + (100 + self.r * sin(self.a0)) + " " + (100 - self.r * cos(self.a0))
                + " A " + self.r + " " + self.r + " 0 " + ((self.a1 - self.a0) > 180deg ? 1 : 0) + " 1 "
                + (100 + self.r * sin(self.a1)) + " " + (100 - self.r * cos(self.a1));
        }

        // Ticks
        for i in root.major-ticks * root.minor-ticks + 1: Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
            property <bool> major: mod(i, root.minor-ticks) == 0;
            property <angle> a: root.start-angle + root.sweep * i / (root.major-ticks * root.minor-ticks);
            property <float> r0: self.major ? 76 : 81;
            stroke: root.ink;
            stroke-width: self.major ? root.side * 0.012 : root.side * 0.006;
            commands: "M " + (100 + self.r0 * sin(self.a)) + " " + (100 - self.r0 * cos(self.a))
                + " L " + (100 + 90 * sin(self.a)) + " " + (100 - 90 * cos(self.a));
        }

        // Major labels
        for i in root.major-ticks + 1: Text {
            property <angle> a: root.start-angle + root.sweep * i / root.major-ticks;
            property <float> v: root.min-value + (root.max-value - root.min-value) * i / root.major-ticks;
            x: parent.width / 2 + parent.width * 0.32 * sin(self.a) - self.width / 2;
            y: parent.height / 2 - parent.height * 0.32 * cos(self.a) - self.height / 2;
            text: round(self.v * 10) / 10;
            color: self.v >= root.redline ? root.danger : root.ink;
            font-size: root.side * 0.07;
            font-weight: 600;
        }

        Text {
            y: parent.height * 0.62;
            x: (parent.width - self.width) / 2;
            text: root.value-text;
            color: root.ink;
            font-size: root.side * 0.12;
            font-weight: 700;
        }

        Text {
            y: parent.height * 0.76;
            x: (parent.width - self.width) / 2;
            text: root.caption;
            color: root.ink.transparentize(40%);
            font-size: root.side * 0.06;
        }

        // Needle
        Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
            fill: root.accent;
            property <angle> a: root.needle-angle;
            commands: "M " + (100 + 84 * sin(self.a)) + " " + (100 - 84 * cos(self.a))
                + " L " + (100 + 4 * cos(self.a)) + " " + (100 + 4 * sin(self.a))
                + " L " + (100 - 14 * sin(self.a)) + " " + (100 + 14 * cos(self.a))
                + " L " + (100 - 4 * cos(self.a)) + " " + (100 - 4 * sin(self.a)) + " Z";
        }

        Rectangle {
            width: root.side * 0.09;
            height: self.width;
            border-radius: self.width / 2;
            background: #21262d;
            border-width: root.side * 0.01;
            border-color: root.accent;
        }
    }
}
