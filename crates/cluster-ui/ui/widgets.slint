// DashCluster widget library. Each widget gets its static config (`st`) and its
// per-frame values (`fr`) from Rust; sizes are relative to the widget's own box so
// everything scales with the dashboard.
//
// Typefaces: labels use Saira Condensed; values use it too, or DSEG7 Classic when the
// widget's `style.font` is "digital". Both are embedded by dashboard.slint.
//
// Glows are drawn as translucent shapes rather than drop shadows, so they also show in
// the software renderer used for snapshots. That renderer doesn't clip gradients to
// rounded corners, so round shapes use solid fills (halos fade out before the corners).

export enum WType { analog-gauge, bar-gauge, readout, gear, shift-lights, lamp, tyre-quad, g-meter, pedals, lap-timer, label, image, panel }

export struct WZone { from: float, to: float, color: color }

export struct WStatic {
    kind: WType,
    x: float, y: float, w: float, h: float,
    ink: color, muted: color, accent: color, face: color, danger: color, edge: color,
    unit-color: color,
    font-scale: float,
    // Values use the seven-segment face.
    digital: bool,
    // Widget-specific look; the numbers are listed in cluster_layout::eval::variant.
    variant: int,
    // Panel hairlines: 1 top, 2 bottom, 4 left, 8 right.
    edges: int,
    min: float, max: float,
    major: int, minor: int,
    start-angle: float, sweep: float,
    arc-indicator: bool,
    zones: [WZone],
    caption: string, label: string, unit: string,
    // 0 = left, 1 = center, 2 = right
    align: int,
    vertical: bool,
    show-value: bool,
    segments: [color],
    color: color,
    icon: string,
    names: [string],
    image: image,
    // 0 = contain, 1 = cover, 2 = fill
    fit: int,
    max-g: float,
    show-last: bool,
    show-best: bool,
}

export struct WFrame {
    valid: bool, on: bool,
    v0: float, v1: float, v2: float, v3: float,
    t0: string, t1: string, t2: string, t3: string,
    c0: color, c1: color, c2: color, c3: color,
}

export global DashFonts {
    out property <string> sans: "Saira Condensed";
    out property <string> digital: "DSEG7 Classic";
}

component Base inherits Rectangle {
    in property <WStatic> st;
    in property <WFrame> fr;
    // Typeface and size correction for values (DSEG digits run larger than Saira's).
    out property <string> value-font: root.st.digital ? DashFonts.digital : DashFonts.sans;
    out property <float> value-scale: root.st.font-scale * (root.st.digital ? 0.74 : 1.0);
    // Average advance of a digit in em, for fitting values into a width.
    out property <float> glyph-w: root.st.digital ? 0.62 : 0.44;
    opacity: root.fr.valid ? 1 : 0.45;
}

// Small caps caption used by most widgets.
component Caption inherits Text {
    in property <length> size;
    font-family: DashFonts.sans;
    font-size: self.size;
    font-weight: 600;
    letter-spacing: self.size * 0.08;
}

// ---------------------------------------------------------------- analog gauge
component DialArc inherits Path {
    in property <angle> start;
    in property <angle> sweep;
    property <angle> middle: self.start + self.sweep / 2;
    property <angle> end: self.start + self.sweep;
    in property <float> radius: 87;
    viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
    visible: self.sweep > 0deg;
    commands: "M " + (100 + self.radius * sin(self.start)) + " " + (100 - self.radius * cos(self.start))
        + " A " + self.radius + " " + self.radius + " 0 0 1 "
        + (100 + self.radius * sin(self.middle)) + " " + (100 - self.radius * cos(self.middle))
        + " A " + self.radius + " " + self.radius + " 0 0 1 "
        + (100 + self.radius * sin(self.end)) + " " + (100 - self.radius * cos(self.end));
}

export component AnalogGaugeW inherits Base {
    property <length> side: min(self.width, self.height);
    property <float> span: max(0.0001, root.st.max - root.st.min);
    property <float> frac: clamp((root.fr.v0 - root.st.min) / self.span, -0.02, 1.03);
    property <angle> a0: root.st.start-angle * 1deg;
    property <angle> sw: root.st.sweep * 1deg;
    property <int> nticks: root.st.major * root.st.minor;
    property <bool> arc: root.st.arc-indicator;
    property <bool> hub: root.st.variant == 1;
    // The value sits in the middle (large) for arc dials and hubs, low (small) under a needle.
    property <bool> big-center: self.arc || self.hub;
    property <float> hub-d: self.arc ? 0.4 : 0.5;

    disc := Rectangle {
        width: root.side;
        height: root.side;
        border-radius: self.width / 2;
        background: root.st.face;
        border-width: root.st.face.alpha > 0 ? root.side * 0.012 : 0;
        border-color: root.st.edge;

        // Track for the illuminated sweep.
        if root.arc: DialArc {
            width: 100%; height: 100%;
            start: root.a0; sweep: root.sw;
            stroke: root.st.edge.transparentize(30%);
            stroke-width: root.side * 0.06;
        }

        // Zones: a translucent band under an arc, a solid band inside the ticks of a needle dial.
        for z in root.st.zones: DialArc {
            width: 100%;
            height: 100%;
            property <float> f0: clamp((z.from - root.st.min) / root.span, 0, 1);
            property <float> f1: clamp((z.to - root.st.min) / root.span, 0, 1);
            start: root.a0 + root.sw * self.f0;
            sweep: root.sw * (self.f1 - self.f0);
            radius: root.arc ? 87 : 85.5;
            stroke: root.arc ? z.color.transparentize(45%) : z.color;
            stroke-width: root.side * (root.arc ? 0.06 : 0.04);
        }

        // Lit sweep with a soft halo.
        if root.arc: DialArc {
            width: 100%; height: 100%;
            start: root.a0; sweep: root.sw * clamp(root.frac, 0, 1);
            stroke: root.fr.c0.transparentize(82%);
            stroke-width: root.side * 0.1;
        }
        if root.arc: DialArc {
            width: 100%; height: 100%;
            start: root.a0; sweep: root.sw * clamp(root.frac, 0, 1);
            stroke: root.fr.c0;
            stroke-width: root.side * 0.06;
        }

        for i in root.nticks + 1: Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
            property <bool> major: mod(i, root.st.minor) == 0;
            property <angle> a: root.a0 + root.sw * i / max(1, root.nticks);
            property <float> r0: root.arc ? (self.major ? 71 : 75) : (self.major ? 77 : 82);
            property <float> r1: root.arc ? 79 : 90;
            stroke: self.major ? root.st.ink : root.st.ink.transparentize(45%);
            stroke-width: self.major ? root.side * 0.012 : root.side * 0.005;
            commands: "M " + (100 + self.r0 * sin(self.a)) + " " + (100 - self.r0 * cos(self.a))
                + " L " + (100 + self.r1 * sin(self.a)) + " " + (100 - self.r1 * cos(self.a));
        }

        for i in root.st.major + 1: Text {
            property <angle> a: root.a0 + root.sw * i / max(1, root.st.major);
            property <float> v: root.st.min + root.span * i / max(1, root.st.major);
            property <float> r: root.arc ? 0.272 : 0.315;
            x: parent.width / 2 + parent.width * self.r * sin(self.a) - self.width / 2;
            y: parent.height / 2 - parent.height * self.r * cos(self.a) - self.height / 2;
            text: round(self.v * 100) / 100;
            color: root.st.ink;
            font-family: DashFonts.sans;
            font-size: root.side * (root.arc ? 0.068 : 0.075) * root.st.font-scale;
            font-weight: 600;
        }

        // Needle: tapered, from behind the center (or from the hub's rim) to the ticks.
        if !root.arc: Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
            fill: root.st.accent;
            property <angle> a: root.a0 + root.sw * root.frac;
            property <float> tail: root.hub ? -40 : 16;
            property <float> base: root.hub ? 2.6 : 3.6;
            commands: "M " + (100 + 88 * sin(self.a) + 0.6 * cos(self.a)) + " " + (100 - 88 * cos(self.a) + 0.6 * sin(self.a))
                + " L " + (100 + 88 * sin(self.a) - 0.6 * cos(self.a)) + " " + (100 - 88 * cos(self.a) - 0.6 * sin(self.a))
                + " L " + (100 - self.tail * sin(self.a) - self.base * cos(self.a)) + " " + (100 + self.tail * cos(self.a) - self.base * sin(self.a))
                + " L " + (100 - self.tail * sin(self.a) + self.base * cos(self.a)) + " " + (100 + self.tail * cos(self.a) + self.base * sin(self.a)) + " Z";
        }

        if !root.arc && !root.hub: Rectangle {
            width: root.side * 0.085;
            height: self.width;
            border-radius: self.width / 2;
            background: root.st.face.alpha > 0 ? root.st.face.brighter(30%) : #1a1a1a;
            border-width: root.side * 0.012;
            border-color: root.st.accent;
        }

        if root.hub: Rectangle {
            width: root.side * root.hub-d;
            height: self.width;
            border-radius: self.width / 2;
            background: root.st.face.darker(55%);
            border-width: root.side * 0.008;
            border-color: root.st.edge;
        }

        Text {
            y: root.big-center ? parent.height * 0.48 - self.height / 2
                : parent.height * (root.st.unit == "" ? 0.6 : 0.55);
            x: (parent.width - self.width) / 2;
            text: root.fr.t0;
            color: root.fr.c1;
            font-family: root.value-font;
            // Fits within the tick numbers (arc/hub) or between the lower ticks (needle).
            font-size: min(root.side * (root.big-center ? 0.23 : 0.13) * root.value-scale,
                root.side * (root.big-center ? (root.arc ? 0.36 : 0.42) : 0.3)
                    / (max(2, self.text.character-count) * root.glyph-w));
            font-weight: 700;
        }

        if root.st.unit != "": Text {
            y: parent.height * (root.big-center ? 0.585 : 0.69);
            x: (parent.width - self.width) / 2;
            text: root.st.unit;
            color: root.st.unit-color;
            font-family: DashFonts.sans;
            font-size: root.side * 0.05 * root.st.font-scale;
            font-weight: 600;
        }

        Caption {
            y: parent.height * (root.big-center ? (root.hub ? 0.79 : 0.65) : 0.765);
            x: (parent.width - self.width) / 2;
            text: root.st.caption;
            color: root.st.muted;
            size: root.side * 0.052 * root.st.font-scale;
        }
    }
}

// ---------------------------------------------------------------- bar gauge
export component BarGaugeW inherits Base {
    property <length> thick: root.st.vertical ? root.width : root.height;
    property <length> pad: self.thick * 0.14;
    property <float> f: clamp(root.fr.v0, 0, 1);
    property <float> span: max(0.0001, root.st.max - root.st.min);
    // Where zero sits in the range, for center bars.
    property <float> zf: clamp((0 - root.st.min) / self.span, 0, 1);
    property <bool> is-center: root.st.variant == 1;
    property <bool> is-curve: root.st.variant == 2;

    // ---- continuous bar (plain or center-zero)
    if root.st.segments.length == 0 && !root.is-curve: Rectangle {
        border-radius: root.is-center ? 0 : root.thick * 0.14;
        background: root.st.face;
        border-width: 1px;
        border-color: root.st.edge;
        clip: true;

        if !root.is-center: Rectangle {
            x: 0;
            y: root.st.vertical ? parent.height * (1 - root.f) : 0;
            width: root.st.vertical ? parent.width : parent.width * root.f;
            height: root.st.vertical ? parent.height * root.f : parent.height;
            background: root.st.vertical
                ? @linear-gradient(0deg, root.fr.c0.darker(25%) 0%, root.fr.c0 100%)
                : @linear-gradient(90deg, root.fr.c0.darker(25%) 0%, root.fr.c0 100%);
        }

        if root.is-center: Rectangle {
            x: parent.width * min(root.zf, root.f);
            width: parent.width * abs(root.f - root.zf);
            height: parent.height;
            background: root.fr.c0;
        }
        if root.is-center: Rectangle {
            x: parent.width * root.zf - 1px;
            width: 2px;
            height: parent.height;
            background: root.st.ink;
        }

        // Zone markers
        if !root.is-center: Rectangle {
            for z in root.st.zones: Rectangle {
                property <float> zf: clamp(((z.from > root.st.min ? z.from : z.to) - root.st.min) / root.span, 0, 1);
                x: root.st.vertical ? 0 : parent.width * self.zf - 1px;
                y: root.st.vertical ? parent.height * (1 - self.zf) - 1px : 0;
                width: root.st.vertical ? parent.width : 2px;
                height: root.st.vertical ? 2px : parent.height;
                background: z.color;
                opacity: 0.85;
            }
        }
    }

    // ---- rising segmented strip
    for c[i] in root.st.segments: Rectangle {
        property <length> cell: root.width / max(1, root.st.segments.length);
        property <float> rise: min(1, i * 3 / max(1, root.st.segments.length - 1));
        property <float> filled: clamp(root.f * root.st.segments.length - i, 0, 1);
        x: i * self.cell;
        y: root.height - self.height;
        width: self.cell * 0.82;
        height: root.height * (0.24 + 0.76 * self.rise * (2 - self.rise));
        background: c.transparentize(90%);
        border-width: 1px;
        border-color: c.transparentize(75%);
        Rectangle {
            x: 0;
            width: parent.width * parent.filled;
            height: parent.height;
            background: @linear-gradient(180deg, c 0%, c.darker(20%) 100%);
        }
    }

    // ---- curve: a band that rises and sweeps across, filled up to the value
    if root.is-curve: curve := Rectangle {
        property <length> tick-h: root.height * 0.16;
        property <float> W: root.width / 1px;
        property <float> H: (root.height - self.tick-h) / 1px;
        property <float> kx: self.W / 1000;
        property <float> ky: self.H / 100;
        property <string> band: "M 0 " + (100 * self.ky)
            + " C " + (130 * self.kx) + " " + (100 * self.ky) + " " + (230 * self.kx) + " 0 " + (400 * self.kx) + " 0"
            + " L " + self.W + " 0 L " + self.W + " " + (40 * self.ky) + " L " + (430 * self.kx) + " " + (40 * self.ky)
            + " C " + (300 * self.kx) + " " + (40 * self.ky) + " " + (220 * self.kx) + " " + (100 * self.ky) + " " + (140 * self.kx) + " " + (100 * self.ky) + " Z";
        property <string> rail: "M 0 " + (100 * self.ky) + " L " + (140 * self.kx) + " " + (100 * self.ky)
            + " C " + (220 * self.kx) + " " + (100 * self.ky) + " " + (300 * self.kx) + " " + (40 * self.ky) + " " + (430 * self.kx) + " " + (40 * self.ky)
            + " L " + self.W + " " + (40 * self.ky);
        width: root.width;
        height: root.height;

        Path {
            x: 0; y: 0;
            width: root.width;
            height: root.height - parent.tick-h;
            viewbox-x: 0; viewbox-y: 0; viewbox-width: parent.W; viewbox-height: parent.H;
            commands: parent.band;
            fill: root.st.face;
            stroke: root.st.edge;
            stroke-width: 1px;
        }
        for z in root.st.zones: Rectangle {
            property <float> f0: clamp((z.from - root.st.min) / root.span, 0, 1);
            property <float> f1: clamp((z.to - root.st.min) / root.span, 0, 1);
            x: root.width * self.f0;
            y: 0;
            width: root.width * (self.f1 - self.f0);
            height: root.height - parent.tick-h;
            clip: true;
            Path {
                x: -parent.x;
                y: 0;
                width: root.width;
                height: parent.height;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: curve.W; viewbox-height: curve.H;
                commands: curve.band;
                fill: z.color.transparentize(80%);
            }
        }
        Rectangle {
            x: 0;
            y: 0;
            width: root.width * root.f;
            height: root.height - parent.tick-h;
            clip: true;
            Path {
                x: 0; y: 0;
                width: root.width;
                height: parent.height;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: curve.W; viewbox-height: curve.H;
                commands: curve.band;
                fill: root.fr.c0;
            }
        }
        Path {
            x: 0; y: 0;
            width: root.width;
            height: root.height - parent.tick-h;
            viewbox-x: 0; viewbox-y: 0; viewbox-width: parent.W; viewbox-height: parent.H;
            commands: parent.rail;
            stroke: root.st.danger;
            stroke-width: max(2px, root.height * 0.012);
        }
        // Tick numbers ride just under the red rail.
        for i in root.st.major + 1: Text {
            property <float> v: root.st.min + root.span * i / max(1, root.st.major);
            property <float> t: clamp((1000 * i / max(1, root.st.major) - 140) / 290, 0, 1);
            property <float> rail-y: 100 - 60 * self.t * self.t * (3 - 2 * self.t);
            x: clamp(root.width * i / max(1, root.st.major) - self.width / 2, 0, root.width - self.width);
            y: (root.height - curve.tick-h) * self.rail-y / 100 + curve.tick-h * 0.1;
            height: curve.tick-h;
            vertical-alignment: center;
            text: round(self.v * 100) / 100;
            color: root.st.ink;
            font-family: DashFonts.sans;
            font-size: parent.tick-h * 0.8 * root.st.font-scale;
            font-weight: 700;
            font-italic: true;
        }
    }

    if !root.st.vertical && !root.is-curve && root.st.label != "": Rectangle {
        x: root.pad * 0.6;
        y: root.height * 0.14;
        width: label-text.preferred-width + root.pad * 1.8;
        height: root.height * 0.72;
        border-radius: root.height * 0.12;
        background: root.st.face.transparentize(25%);
        label-text := Caption {
            x: root.pad * 0.9;
            height: parent.height;
            vertical-alignment: center;
            text: root.st.label;
            color: root.st.ink;
            size: root.height * 0.46 * root.st.font-scale;
        }
    }
    if !root.st.vertical && !root.is-curve && root.st.show-value: Rectangle {
        x: root.width - self.width - root.pad * 0.6;
        y: root.height * 0.14;
        width: value-row.preferred-width + root.pad * 1.8;
        height: root.height * 0.72;
        border-radius: root.height * 0.12;
        background: root.st.face.transparentize(25%);
        value-row := HorizontalLayout {
            x: root.pad * 0.9;
            width: self.preferred-width;
            height: parent.height;
            spacing: root.height * 0.08;
            Text {
                vertical-alignment: center;
                text: root.fr.t0;
                color: root.st.ink;
                font-family: root.value-font;
                font-size: root.height * 0.5 * root.value-scale;
                font-weight: 700;
            }
            if root.st.unit != "": Text {
                vertical-alignment: center;
                text: root.st.unit;
                color: root.st.unit-color;
                font-family: DashFonts.sans;
                font-size: root.height * 0.34 * root.st.font-scale;
                font-weight: 600;
            }
        }
    }
    if root.st.vertical: Caption {
        y: root.height - self.height - root.pad;
        width: root.width;
        horizontal-alignment: center;
        text: root.st.label;
        color: root.st.ink;
        size: root.width * 0.26 * root.st.font-scale;
    }
    if root.st.vertical && root.st.show-value: Text {
        y: root.pad;
        width: root.width;
        horizontal-alignment: center;
        text: root.fr.t0;
        color: root.st.ink;
        font-family: root.value-font;
        font-size: root.width * 0.32 * root.value-scale;
        font-weight: 700;
    }
}

// ---------------------------------------------------------------- readout
export component ReadoutW inherits Base {
    property <bool> has-label: root.st.label != "";
    property <bool> below: root.st.variant == 1;
    property <length> label-h: self.has-label ? root.height * 0.24 : 0;
    property <length> value-h: root.height - self.label-h;
    property <length> unit-size: self.value-h * 0.3 * root.st.font-scale;
    property <length> unit-w: root.st.unit == "" ? 0 : root.st.unit.character-count * self.unit-size * 0.55 + root.height * 0.04;
    property <TextHorizontalAlignment> ha: root.st.align == 0 ? TextHorizontalAlignment.left : root.st.align == 2 ? TextHorizontalAlignment.right : TextHorizontalAlignment.center;

    if root.has-label: Caption {
        x: 0;
        y: root.below ? root.value-h : 0;
        width: root.width;
        height: root.label-h;
        horizontal-alignment: root.ha;
        vertical-alignment: center;
        text: root.st.label;
        color: root.st.muted;
        size: root.label-h * 0.78;
    }
    HorizontalLayout {
        x: 0;
        width: root.width;
        y: root.below ? 0 : root.label-h;
        height: root.value-h;
        alignment: root.st.align == 0 ? LayoutAlignment.start : root.st.align == 2 ? LayoutAlignment.end : LayoutAlignment.center;
        spacing: root.height * 0.04;
        Text {
            vertical-alignment: center;
            text: root.fr.t0;
            color: root.fr.c0;
            font-family: root.value-font;
            font-size: min(root.value-h * 0.84 * root.value-scale,
                (root.width - root.unit-w) / (max(1, self.text.character-count) * root.glyph-w));
            font-weight: 700;
        }
        if root.st.unit != "": Text {
            vertical-alignment: center;
            text: root.st.unit;
            color: root.st.unit-color;
            font-family: DashFonts.sans;
            font-size: root.unit-size;
            font-weight: 600;
        }
    }
}

// ---------------------------------------------------------------- gear
export component GearW inherits Base {
    opacity: 1;
    property <bool> framed: root.st.variant != 0;
    property <bool> hex: root.st.variant == 2;
    property <length> side: min(root.width, root.height);

    // Plain: a highlight box appears only when it's time to shift.
    if !root.framed: Rectangle {
        border-radius: root.side * 0.12;
        background: root.fr.on ? root.st.accent.transparentize(75%) : transparent;
        border-width: root.fr.on ? 3px : 0;
        border-color: root.st.accent;
    }
    if root.st.variant == 1: Rectangle {
        border-radius: root.side * 0.06;
        background: root.fr.on ? root.st.accent.transparentize(70%) : root.st.face;
        border-width: max(1px, root.side * 0.012);
        border-color: root.fr.on ? root.st.accent : root.st.edge;
    }
    if root.hex: Path {
        width: root.width;
        height: root.height;
        property <float> W: root.width / 1px;
        property <float> H: root.height / 1px;
        property <float> c: min(self.W * 0.16, self.H * 0.5);
        viewbox-x: 0; viewbox-y: 0; viewbox-width: self.W; viewbox-height: self.H;
        commands: "M " + self.c + " 1 L " + (self.W - self.c) + " 1 L " + (self.W - 1) + " " + (self.H / 2)
            + " L " + (self.W - self.c) + " " + (self.H - 1) + " L " + self.c + " " + (self.H - 1)
            + " L 1 " + (self.H / 2) + " Z";
        fill: root.fr.on ? root.st.accent.transparentize(70%) : root.st.face;
        stroke: root.fr.on ? root.st.accent : root.st.edge;
        stroke-width: max(1.5px, root.side * 0.014);
    }
    // Hex frames carry a shift bar under the digit.
    if root.hex: Rectangle {
        x: root.width * 0.3;
        y: root.height * 0.86;
        width: root.width * 0.4;
        height: root.height * 0.045;
        border-radius: self.height / 2;
        background: root.fr.on ? root.st.accent : root.st.edge;
    }
    Text {
        width: root.width;
        height: root.framed ? root.height * (root.hex ? 0.92 : 1) : root.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.fr.t0;
        color: root.fr.on ? root.st.accent : root.st.ink;
        font-family: root.value-font;
        font-size: root.side * (root.framed ? 0.74 : 0.92) * root.value-scale;
        font-weight: 700;
    }
}

// ---------------------------------------------------------------- shift lights
export component ShiftLightsW inherits Base {
    property <int> n: root.st.segments.length;
    property <length> cell: root.width / max(1, self.n);
    property <bool> bars: root.st.variant == 1;
    property <length> led-w: self.bars ? self.cell * 0.82 : min(self.cell * 0.74, root.height * 0.86);
    property <length> led-h: self.bars ? root.height * 0.62 : self.led-w;
    property <int> lit: round(root.fr.v0 * self.n);
    for c[i] in root.st.segments: led-slot := Rectangle {
        property <bool> on: i < root.lit;
        property <color> led: root.fr.on ? root.st.color : c;
        x: root.cell * i + (root.cell - root.led-w) / 2;
        y: (root.height - root.led-h) / 2;
        width: root.led-w;
        height: root.led-h;

        // Halo
        if led-slot.on: Rectangle {
            width: parent.width * 1.7;
            height: parent.height * 1.7;
            border-radius: root.bars ? self.height * 0.3 : self.width / 2;
            background: @radial-gradient(circle, led-slot.led.transparentize(45%) 0%, led-slot.led.transparentize(100%) 70%);
        }
        // Bezel
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: root.bars ? self.height * 0.14 : self.width / 2;
            background: #050607;
            border-width: max(1px, min(self.width, self.height) * 0.05);
            border-color: #2a3038;
        }
        // Lens
        Rectangle {
            width: parent.width * 0.84;
            height: parent.height * 0.84;
            border-radius: root.bars ? self.height * 0.12 : self.width / 2;
            background: led-slot.on ? led-slot.led : c.transparentize(80%).darker(40%);
        }
        // Hot spot
        if led-slot.on: Rectangle {
            width: parent.width * 0.42;
            height: parent.height * 0.42;
            border-radius: root.bars ? self.height * 0.2 : self.width / 2;
            background: led-slot.led.brighter(80%).transparentize(30%);
        }
    }
}

// ---------------------------------------------------------------- lamp
export component LampW inherits Base {
    opacity: 1;
    if root.fr.on: Rectangle {
        width: root.width * 1.15;
        height: root.height * 1.4;
        border-radius: self.height / 2;
        background: @radial-gradient(circle, root.st.color.transparentize(65%) 0%, root.st.color.transparentize(100%) 70%);
    }
    Rectangle {
        border-radius: min(root.width, root.height) * 0.3;
        background: root.fr.on ? root.st.color.transparentize(78%) : root.st.face.darker(30%);
        border-width: 1.5px;
        border-color: root.fr.on ? root.st.color : root.st.edge.transparentize(30%);
    }
    Text {
        width: root.width;
        height: root.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.st.icon;
        color: root.fr.on ? root.st.color.brighter(30%) : root.st.muted.transparentize(65%);
        font-family: DashFonts.sans;
        font-size: root.height * 0.52 * root.st.font-scale;
        font-weight: 700;
        letter-spacing: root.height * 0.03;
    }
}

// ---------------------------------------------------------------- tyre quad
component Tile inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    in property <color> ink;
    in property <string> font;
    in property <float> font-scale;
    border-radius: min(self.width, self.height) * 0.12;
    background: @linear-gradient(180deg, self.tint.transparentize(70%) 0%, self.tint.transparentize(88%) 100%);
    border-width: 2px;
    border-color: self.tint;
    Text {
        text: root.text;
        color: root.ink;
        font-family: root.font;
        font-size: min(root.width, root.height) * 0.36 * root.font-scale;
        font-weight: 700;
    }
}

// One wheel of the car layout: the tyre and its value beside it.
component Wheel inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    in property <string> font;
    in property <float> font-scale;
    in property <length> tyre-x;
    in property <length> tyre-w;
    // Value on the left (true) or right (false) of the tyre.
    in property <bool> value-left;
    Rectangle {
        x: root.tyre-x;
        width: root.tyre-w;
        height: root.height;
        border-radius: self.width * 0.32;
        background: @linear-gradient(90deg, root.tint.darker(25%) 0%, root.tint 50%, root.tint.darker(25%) 100%);
    }
    Text {
        x: root.value-left ? 0 : root.tyre-x + root.tyre-w + root.tyre-w * 0.25;
        width: root.value-left ? root.tyre-x - root.tyre-w * 0.25 : root.width - self.x;
        height: root.height;
        horizontal-alignment: root.value-left ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        vertical-alignment: center;
        text: root.text;
        color: root.tint;
        font-family: root.font;
        font-size: root.height * 0.42 * root.font-scale;
        font-weight: 700;
    }
}

export component TyreQuadW inherits Base {
    property <string> title: root.st.unit == "" ? root.st.label
        : root.st.label == "" ? root.st.unit : root.st.label + " · " + root.st.unit;
    property <length> label-h: self.title != "" ? root.height * 0.11 : 0;
    property <length> body-h: root.height - self.label-h;
    property <bool> car: root.st.variant == 1;
    if root.title != "": Caption {
        x: 0;
        y: 0;
        width: root.width;
        height: root.label-h;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.title;
        color: root.st.muted;
        size: root.label-h * 0.72;
    }

    if !root.car: Rectangle {
        y: root.label-h;
        height: root.body-h;
        property <length> gap: root.width * 0.05;
        property <length> tw: (root.width - self.gap) / 2;
        property <length> th: (self.height - self.gap) / 2;
        Tile { x: 0; y: 0; width: parent.tw; height: parent.th; text: root.fr.t0; tint: root.fr.c0; ink: root.st.ink; font: root.value-font; font-scale: root.value-scale; }
        Tile { x: parent.tw + parent.gap; y: 0; width: parent.tw; height: parent.th; text: root.fr.t1; tint: root.fr.c1; ink: root.st.ink; font: root.value-font; font-scale: root.value-scale; }
        Tile { x: 0; y: parent.th + parent.gap; width: parent.tw; height: parent.th; text: root.fr.t2; tint: root.fr.c2; ink: root.st.ink; font: root.value-font; font-scale: root.value-scale; }
        Tile { x: parent.tw + parent.gap; y: parent.th + parent.gap; width: parent.tw; height: parent.th; text: root.fr.t3; tint: root.fr.c3; ink: root.st.ink; font: root.value-font; font-scale: root.value-scale; }
    }

    if root.car: Rectangle {
        y: root.label-h;
        height: root.body-h;
        property <length> tw: root.width * 0.12;
        property <length> th: self.height * 0.34;
        property <length> lx: root.width * 0.31;
        property <length> rx: root.width * 0.69 - self.tw;
        property <length> fy: self.height * 0.05;
        property <length> ry: self.height * 0.95 - self.th;
        property <length> line: max(2px, root.width * 0.012);
        // Chassis: axles and spine.
        Rectangle { x: parent.lx + parent.tw; y: parent.fy + parent.th / 2 - parent.line / 2; width: parent.rx - self.x; height: parent.line; background: root.st.edge; }
        Rectangle { x: parent.lx + parent.tw; y: parent.ry + parent.th / 2 - parent.line / 2; width: parent.rx - self.x; height: parent.line; background: root.st.edge; }
        Rectangle { x: root.width / 2 - parent.line / 2; y: parent.fy + parent.th / 2; width: parent.line; height: parent.ry - parent.fy; background: root.st.edge; }
        Rectangle {
            x: root.width / 2 - self.width / 2; y: parent.fy + parent.th / 2 - self.height / 2;
            width: parent.tw * 0.7; height: parent.line * 4; border-radius: parent.line;
            background: root.st.face; border-width: 1px; border-color: root.st.edge;
        }
        Rectangle {
            x: root.width / 2 - self.width / 2; y: parent.ry + parent.th / 2 - self.height / 2;
            width: parent.tw * 0.9; height: parent.line * 5; border-radius: parent.line;
            background: root.st.face; border-width: 1px; border-color: root.st.edge;
        }
        Wheel { x: 0; y: parent.fy; width: root.width / 2; height: parent.th; tyre-x: parent.lx; tyre-w: parent.tw; value-left: true; text: root.fr.t0; tint: root.fr.c0; font: root.value-font; font-scale: root.value-scale; }
        Wheel { x: root.width / 2; y: parent.fy; width: root.width / 2; height: parent.th; tyre-x: parent.rx - self.x; tyre-w: parent.tw; value-left: false; text: root.fr.t1; tint: root.fr.c1; font: root.value-font; font-scale: root.value-scale; }
        Wheel { x: 0; y: parent.ry; width: root.width / 2; height: parent.th; tyre-x: parent.lx; tyre-w: parent.tw; value-left: true; text: root.fr.t2; tint: root.fr.c2; font: root.value-font; font-scale: root.value-scale; }
        Wheel { x: root.width / 2; y: parent.ry; width: root.width / 2; height: parent.th; tyre-x: parent.rx - self.x; tyre-w: parent.tw; value-left: false; text: root.fr.t3; tint: root.fr.c3; font: root.value-font; font-scale: root.value-scale; }
    }
}

// ---------------------------------------------------------------- g meter
export component GMeterW inherits Base {
    property <length> side: min(self.width, self.height);
    property <length> r: self.side / 2;
    // One ring every 0.5 g, up to the meter's range.
    property <int> rings: max(1, floor(root.st.max-g * 2));
    Rectangle {
        width: root.side;
        height: root.side;
        border-radius: root.r;
        background: root.st.face;
        border-width: 2px;
        border-color: root.st.edge;
        for i in root.rings: Rectangle {
            width: root.side * min(1, (i + 1) * 0.5 / root.st.max-g);
            height: self.width;
            border-radius: self.width / 2;
            border-width: 1px;
            border-color: mod(i, 2) == 1 ? root.st.muted.transparentize(40%) : root.st.edge.transparentize(30%);
        }
        Rectangle { width: 1px; height: 100%; background: root.st.edge; }
        Rectangle { height: 1px; width: 100%; background: root.st.edge; }
        Rectangle {
            property <float> rx: root.fr.v0 / root.st.max-g;
            property <float> ry: root.fr.v1 / root.st.max-g;
            property <float> len: sqrt(self.rx * self.rx + self.ry * self.ry);
            property <float> k: self.len > 1 ? 1 / self.len : 1;
            property <float> gx: self.rx * self.k;
            property <float> gy: self.ry * self.k;
            property <length> d: root.side * 0.09;
            x: root.r + (root.r - self.d) * self.gx - self.d / 2;
            y: root.r - (root.r - self.d) * self.gy - self.d / 2;
            width: self.d;
            height: self.d;
            Rectangle {
                width: parent.width * 1.9;
                height: self.width;
                border-radius: self.width / 2;
                background: @radial-gradient(circle, root.st.accent.transparentize(50%) 0%, root.st.accent.transparentize(100%) 70%);
            }
            Rectangle {
                border-radius: self.width / 2;
                background: root.st.accent;
                border-width: 1.5px;
                border-color: root.st.accent.brighter(60%);
            }
        }
        Text {
            y: parent.height * 0.8;
            text: root.fr.t0;
            color: root.st.ink;
            font-family: root.value-font;
            font-size: root.side * 0.085 * root.value-scale;
            font-weight: 700;
        }
    }
}

// ---------------------------------------------------------------- pedals
export component PedalsW inherits Base {
    property <int> n: root.st.segments.length;
    property <bool> labels: root.st.names.length > 0;
    property <bool> values: root.st.variant == 1;
    property <length> label-h: self.labels ? root.height * 0.1 : 0;
    property <length> value-h: self.values ? root.height * 0.1 : 0;
    property <length> cell: root.width / max(1, self.n);
    property <length> bar-w: self.cell * 0.46;
    for c[i] in root.st.segments: Rectangle {
        property <float> v: clamp(i == 0 ? root.fr.v0 : i == 1 ? root.fr.v1 : i == 2 ? root.fr.v2 : root.fr.v3, 0, 1);
        x: root.cell * i;
        width: root.cell;
        height: root.height;
        if root.values: Text {
            y: 0;
            height: root.value-h;
            width: parent.width;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: round(parent.v * 100);
            color: parent.v > 0.02 ? c : root.st.muted;
            font-family: root.value-font;
            font-size: root.value-h * 0.8 * root.value-scale;
            font-weight: 700;
        }
        Rectangle {
            x: (root.cell - root.bar-w) / 2;
            y: root.value-h;
            width: root.bar-w;
            height: root.height - root.label-h - root.value-h - 4px;
            border-radius: root.bar-w * 0.2;
            background: root.st.face;
            border-width: 1px;
            border-color: root.st.edge;
            clip: true;
            Rectangle {
                y: parent.height * (1 - v);
                height: parent.height * v;
                background: @linear-gradient(180deg, c.brighter(25%) 0%, c 30%, c.darker(30%) 100%);
            }
        }
        if root.labels: Caption {
            y: root.height - root.label-h;
            height: root.label-h;
            width: parent.width;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.st.names[i];
            color: root.st.muted;
            size: root.label-h * 0.62 * root.st.font-scale;
        }
    }
}

// ---------------------------------------------------------------- lap timer
export component LapTimerW inherits Base {
    property <length> u: root.height / 10;
    property <bool> columns: root.st.variant == 1;
    // Largest size at which "0:00.000" fits the given width.
    property <length> fit-full: root.width * 0.96 / (8 * root.glyph-w);
    property <length> fit-half: root.width * 0.46 / (8 * root.glyph-w);

    if !root.columns: VerticalLayout {
        alignment: start;
        spacing: root.u * 0.2;
        Caption { text: root.fr.t3; color: root.st.muted; size: root.u * 0.95 * root.st.font-scale; }
        Text { text: root.fr.t0; color: root.st.ink; font-family: root.value-font; font-size: min(root.u * 2.4 * root.value-scale, root.fit-full); font-weight: 700; }
        if root.st.show-last: HorizontalLayout {
            spacing: root.u * 0.4;
            Caption { text: "LAST"; color: root.st.muted; vertical-alignment: center; size: root.u * 0.8 * root.st.font-scale; min-width: root.u * 3; }
            Text { text: root.fr.t1; color: root.st.ink; font-family: root.value-font; font-size: min(root.u * 1.5 * root.value-scale, root.fit-full * 0.7); font-weight: 600; }
        }
        if root.st.show-best: HorizontalLayout {
            spacing: root.u * 0.4;
            Caption { text: "BEST"; color: root.st.muted; vertical-alignment: center; size: root.u * 0.8 * root.st.font-scale; min-width: root.u * 3; }
            Text { text: root.fr.t2; color: root.st.accent; font-family: root.value-font; font-size: min(root.u * 1.5 * root.value-scale, root.fit-full * 0.7); font-weight: 600; }
        }
    }

    if root.columns: Rectangle {
        Caption { x: 0; y: 0; height: root.u * 1.4; vertical-alignment: center; text: root.fr.t3; color: root.st.muted; size: root.u * 1.0 * root.st.font-scale; }
        Text {
            x: 0; y: root.u * 1.3; height: root.u * 4.2;
            vertical-alignment: center;
            text: root.fr.t0; color: root.st.ink;
            font-family: root.value-font; font-size: min(root.u * 3.6 * root.value-scale, root.fit-full); font-weight: 700;
        }
        Rectangle { x: 0; y: root.u * 5.8; width: root.width; height: 1px; background: root.st.edge; }
        if root.st.show-last: Rectangle {
            x: 0; y: root.u * 6.1; width: root.width / 2; height: root.u * 3.9;
            Caption { x: 0; y: 0; height: root.u * 1.2; vertical-alignment: center; text: "LAST"; color: root.st.muted; size: root.u * 0.9 * root.st.font-scale; }
            Text { x: 0; y: root.u * 1.2; height: root.u * 2.6; vertical-alignment: center; text: root.fr.t1; color: root.st.ink; font-family: root.value-font; font-size: min(root.u * 2.1 * root.value-scale, root.fit-half); font-weight: 600; }
        }
        if root.st.show-best: Rectangle {
            x: root.st.show-last ? root.width / 2 : 0; y: root.u * 6.1; width: root.width / 2; height: root.u * 3.9;
            Caption { x: 0; y: 0; height: root.u * 1.2; vertical-alignment: center; text: "BEST"; color: root.st.muted; size: root.u * 0.9 * root.st.font-scale; }
            Text { x: 0; y: root.u * 1.2; height: root.u * 2.6; vertical-alignment: center; text: root.fr.t2; color: root.st.accent; font-family: root.value-font; font-size: min(root.u * 2.1 * root.value-scale, root.fit-half); font-weight: 600; }
        }
    }
}

// ---------------------------------------------------------------- label
export component LabelW inherits Base {
    opacity: 1;
    Text {
        width: root.width;
        height: root.height;
        vertical-alignment: center;
        horizontal-alignment: root.st.align == 0 ? TextHorizontalAlignment.left : root.st.align == 2 ? TextHorizontalAlignment.right : TextHorizontalAlignment.center;
        text: root.fr.t0;
        color: root.fr.c0;
        font-family: root.value-font;
        font-size: min(root.height * 0.66 * root.value-scale,
            root.width / (max(1, self.text.character-count) * (root.st.digital ? 0.62 : 0.52)));
        font-weight: 700;
        letter-spacing: root.st.digital ? 0 : root.height * 0.02;
    }
}

// ---------------------------------------------------------------- image
export component ImageW inherits Base {
    opacity: 1;
    Image {
        width: root.width;
        height: root.height;
        source: root.st.image;
        image-fit: root.st.fit == 1 ? ImageFit.cover : root.st.fit == 2 ? ImageFit.fill : ImageFit.contain;
    }
}

// ---------------------------------------------------------------- panel
export component PanelW inherits Base {
    property <length> side: min(self.width, self.height);
    property <int> v: root.st.variant;
    property <length> hair: clamp(root.side * 0.005, 1px, 2px);
    property <length> title-h: root.v == 3 ? root.height * 0.5 : min(root.height * 0.18, root.width * 0.07);

    if root.v == 0: Rectangle {
        background: root.st.face;
        border-color: root.st.edge;
        border-width: root.hair;
        border-radius: min(root.side * 0.065, root.width * 0.025);
    }
    if root.v == 1: Rectangle {
        background: root.st.face;
        if mod(root.st.edges, 2) == 1: Rectangle { x: 0; y: 0; width: root.width; height: root.hair; background: root.st.edge; }
        if mod(floor(root.st.edges / 2), 2) == 1: Rectangle { x: 0; y: root.height - root.hair; width: root.width; height: root.hair; background: root.st.edge; }
        if mod(floor(root.st.edges / 4), 2) == 1: Rectangle { x: 0; y: 0; width: root.hair; height: root.height; background: root.st.edge; }
        if mod(floor(root.st.edges / 8), 2) == 1: Rectangle { x: root.width - root.hair; y: 0; width: root.hair; height: root.height; background: root.st.edge; }
    }
    if root.v == 2: Path {
        width: root.width;
        height: root.height;
        property <float> W: root.width / 1px;
        property <float> H: root.height / 1px;
        property <float> c: min(self.W, self.H) * 0.09;
        property <float> e: root.hair / 1px / 2;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: self.W; viewbox-height: self.H;
        commands: "M " + (self.c + self.e) + " " + self.e + " L " + (self.W - self.c - self.e) + " " + self.e
            + " L " + (self.W - self.e) + " " + (self.c + self.e) + " L " + (self.W - self.e) + " " + (self.H - self.c - self.e)
            + " L " + (self.W - self.c - self.e) + " " + (self.H - self.e) + " L " + (self.c + self.e) + " " + (self.H - self.e)
            + " L " + self.e + " " + (self.H - self.c - self.e) + " L " + self.e + " " + (self.c + self.e) + " Z";
        fill: root.st.face;
        stroke: root.st.edge;
        stroke-width: root.hair;
    }
    if root.v == 3: Rectangle {
        background: root.st.face;
    }

    if root.st.label != "": Caption {
        x: root.v == 3 ? root.height * 0.4 : root.title-h * 0.8;
        y: root.v == 3 ? 0 : root.title-h * 0.5;
        height: root.v == 3 ? root.height : root.title-h;
        vertical-alignment: center;
        text: root.st.label;
        color: root.st.muted;
        size: root.title-h * 0.8;
    }
}
