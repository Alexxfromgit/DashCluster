import { Dashboard, WType, WZone, WStatic, WFrame } from "dashboard.slint";
import { Toolbar, WidgetPalette, Inspector, EditOverlay, PropRow, PaletteItem } from "editor.slint";
import { Palette } from "std-widgets.slint";
export { WType, WZone, WStatic, WFrame, PropRow, PaletteItem }

export component MainWindow inherits Window {
    title: "DashCluster — " + root.dashboard-name;
    preferred-width: 1280px;
    preferred-height: 540px;
    min-width: 320px;
    min-height: 200px;
    background: #000;

    in property <string> dashboard-name;
    in-out property <float> canvas-w <=> dash.canvas-w;
    in-out property <float> canvas-h <=> dash.canvas-h;
    in property <[WStatic]> statics <=> dash.statics;
    in property <[WFrame]> frames <=> dash.frames;
    in property <color> bg <=> dash.bg;
    in property <color> bg2 <=> dash.bg2;
    in property <float> bg-angle <=> dash.bg-angle;
    in property <image> bg-image <=> dash.bg-image;
    in property <bool> stale <=> dash.stale;
    in property <string> status-text;
    in property <string> overlay-title;
    in property <string> overlay-detail;
    in property <string> error-text;
    in property <string> toast-text;
    in property <bool> show-status: true;
    in property <bool> show-qr;
    in property <image> qr-image;
    in property <string> qr-url;
    in property <string> qr-detail;
    // Tap zones for touch screens: left third = previous, right third = next, middle = fullscreen.
    in property <bool> touch-nav: false;

    callback next-dashboard();
    callback previous-dashboard();
    callback toggle-units();
    callback toggle-fullscreen();
    callback toggle-status();
    callback toggle-demo();
    callback toggle-qr();

    // ---- editor
    in-out property <bool> edit-mode;
    in property <[bool]> selected;
    in property <int> selection-count;
    in property <[PropRow]> props;
    in property <string> inspector-title;
    in property <[PaletteItem]> palette-items;
    in property <[color]> theme-swatches;
    in property <[string]> theme-names;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> dirty;
    in property <bool> snap: true;
    in property <string> editor-title;
    in property <string> editor-message;
    callback toggle-edit();
    callback editor-pointer-down(x: float, y: float, additive: bool, handle: float);
    callback editor-pointer-move(x: float, y: float);
    callback editor-pointer-up();
    callback add-widget(kind: string);
    callback prop-changed(key: string, value: string);
    callback pick-image(key: string);
    callback undo();
    callback redo();
    callback save();
    callback save-as();
    callback new-dashboard();
    callback import-dashboard();
    callback export-dashboard();
    callback reveal-folder();
    callback toggle-snap();
    callback delete-selected();
    callback duplicate-selected();
    callback clear-selection();
    callback nudge(dx: float, dy: float);
    callback restack(delta: int);
    callback align(how: string);

    init => { Palette.color-scheme = ColorScheme.dark; }

    fs := FocusScope {
        key-pressed(e) => {
            if (root.edit-mode) {
                if (e.modifiers.control || e.modifiers.meta) {
                    if (e.text == "z" || e.text == "Z") {
                        if (e.modifiers.shift) { root.redo(); } else { root.undo(); }
                        return accept;
                    }
                    if (e.text == "y" || e.text == "Y") { root.redo(); return accept; }
                    if (e.text == "d" || e.text == "D") { root.duplicate-selected(); return accept; }
                    if (e.text == "s" || e.text == "S") { root.save(); return accept; }
                    if (e.text == "e" || e.text == "E") { root.toggle-edit(); return accept; }
                    return reject;
                }
                if (e.text == Key.Delete || e.text == Key.Backspace) { root.delete-selected(); return accept; }
                if (e.text == Key.Escape) { root.clear-selection(); return accept; }
                if (e.text == Key.LeftArrow) { root.nudge(e.modifiers.shift ? -10 : -1, 0); return accept; }
                if (e.text == Key.RightArrow) { root.nudge(e.modifiers.shift ? 10 : 1, 0); return accept; }
                if (e.text == Key.UpArrow) { root.nudge(0, e.modifiers.shift ? -10 : -1); return accept; }
                if (e.text == Key.DownArrow) { root.nudge(0, e.modifiers.shift ? 10 : 1); return accept; }
                if (e.text == "g" || e.text == "G") { root.toggle-snap(); return accept; }
                return reject;
            }
            if (e.text == Key.RightArrow || e.text == Key.PageDown) { root.next-dashboard(); return accept; }
            if (e.text == Key.LeftArrow || e.text == Key.PageUp) { root.previous-dashboard(); return accept; }
            if (e.text == "u" || e.text == "U") { root.toggle-units(); return accept; }
            if (e.text == "f" || e.text == "F" || e.text == Key.F11) { root.toggle-fullscreen(); return accept; }
            if (e.text == "s" || e.text == "S") { root.toggle-status(); return accept; }
            if (e.text == "d" || e.text == "D") { root.toggle-demo(); return accept; }
            if (e.text == "q" || e.text == "Q") { root.toggle-qr(); return accept; }
            if (e.text == "e" || e.text == "E") { root.toggle-edit(); return accept; }
            reject
        }

        VerticalLayout {
            if root.edit-mode: Toolbar {
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                dirty: root.dirty;
                snap: root.snap;
                title: root.editor-title;
                message: root.editor-message;
                done => { root.toggle-edit(); }
                undo => { root.undo(); }
                redo => { root.redo(); }
                save => { root.save(); }
                save-as => { root.save-as(); }
                new-dashboard => { root.new-dashboard(); }
                import => { root.import-dashboard(); }
                export => { root.export-dashboard(); }
                reveal-folder => { root.reveal-folder(); }
                toggle-snap => { root.toggle-snap(); }
            }
            HorizontalLayout {
                if root.edit-mode: WidgetPalette {
                    items: root.palette-items;
                    add(kind) => { root.add-widget(kind); fs.focus(); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    dash := Dashboard { }
                    if root.edit-mode: EditOverlay {
                        statics: dash.statics;
                        selected: root.selected;
                        unit: dash.unit;
                        ox: dash.ox;
                        oy: dash.oy;
                        canvas-w: dash.canvas-w;
                        canvas-h: dash.canvas-h;
                        snap: root.snap;
                        pointer-down(x, y, additive, handle) => { root.editor-pointer-down(x, y, additive, handle); }
                        pointer-move(x, y) => { root.editor-pointer-move(x, y); }
                        pointer-up => { root.editor-pointer-up(); }
                        request-focus => { fs.focus(); }
                    }
                    if root.touch-nav && !root.edit-mode: TouchArea {
                        clicked => {
                            if (self.pressed-x < self.width / 3) {
                                root.previous-dashboard();
                            } else if (self.pressed-x > self.width * 2 / 3) {
                                root.next-dashboard();
                            } else {
                                root.toggle-fullscreen();
                            }
                        }
                    }
                }
                if root.edit-mode: Inspector {
                    rows: root.props;
                    title: root.inspector-title;
                    has-selection: root.selection-count > 0;
                    selection-count: root.selection-count;
                    theme-swatches: root.theme-swatches;
                    theme-names: root.theme-names;
                    changed(key, value) => { root.prop-changed(key, value); }
                    pick-image(key) => { root.pick-image(key); }
                    duplicate => { root.duplicate-selected(); }
                    delete => { root.delete-selected(); }
                    restack(d) => { root.restack(d); }
                    align(how) => { root.align(how); }
                }
            }
        }
    }

    if root.overlay-title != "": Rectangle {
        y: (root.height - self.height) / 2;
        height: ov.preferred-height + 32px;
        width: min(root.width - 32px, 640px);
        border-radius: 14px;
        background: #000000d9;
        border-width: 1px;
        border-color: #ffffff33;
        ov := VerticalLayout {
            padding: 16px;
            spacing: 6px;
            Text { text: root.overlay-title; color: #fff; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
            if root.overlay-detail != "": Text {
                text: root.overlay-detail;
                color: #c9d1d9;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    if root.error-text != "": Rectangle {
        x: 12px;
        y: 12px;
        width: root.width - 24px;
        height: err.preferred-height + 20px;
        border-radius: 8px;
        background: #3b0d0ce6;
        border-width: 1px;
        border-color: #ff6b5e;
        err := Text {
            x: 12px;
            width: parent.width - 24px;
            text: root.error-text;
            color: #ffd7d3;
            font-size: 13px;
            wrap: word-wrap;
        }
    }

    if root.toast-text != "": Rectangle {
        y: root.height - 80px;
        width: toast.preferred-width + 32px;
        height: 40px;
        border-radius: 20px;
        background: #000000cc;
        border-width: 1px;
        border-color: #ffffff2a;
        toast := Text { text: root.toast-text; color: #fff; font-size: 15px; font-weight: 600; }
    }

    if root.show-qr: Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.toggle-qr(); } }
        Rectangle {
            width: min(root.width - 32px, 420px);
            height: qr-col.preferred-height;
            border-radius: 16px;
            background: #111820;
            border-width: 1px;
            border-color: #ffffff22;
            qr-col := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Open on your phone"; color: #fff; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                Text { text: "Same Wi-Fi network · scan with the camera"; color: #9aa4b2; font-size: 13px; horizontal-alignment: center; }
                Rectangle {
                    height: min(root.height - 220px, 300px);
                    Image { source: root.qr-image; image-fit: contain; image-rendering: pixelated; width: parent.height; height: parent.height; }
                }
                Text { text: root.qr-url; color: #58a6ff; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
                Text { text: root.qr-detail; color: #9aa4b2; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
            }
        }
    }

    if root.show-status && !root.edit-mode: Text {
        x: 10px;
        y: root.height - self.height - 6px;
        text: root.status-text;
        color: #6e7681;
        font-size: 11px;
    }
}
